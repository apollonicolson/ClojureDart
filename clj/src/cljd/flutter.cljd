(ns cljd.flutter
  {:no-dynamic true}
  (:require ["package:flutter/widgets.dart" :as widgets]
            ["package:flutter/material.dart" :as material]
            ["package:flutter/foundation.dart" :as foundation]
            ["package:flutter/rendering.dart" :as rendering]
            ["package:flutter/scheduler.dart" :as scheduler]
            ["dart:async" :as dart:async]
            ["dart:developer" :as dev]
            ["dart:convert" :as convert]
            ["dart:math" :as dart:math]
            ["dart:ui" :as dart:ui]
            [cljd.string :as str])
  (:host-ns
   (:require [clojure.string :as str])))

(defprotocol Subscribable
  (-subscribe [x f!]
    "Subscribe to updates on x.
     f! is a side-effecting function of one argument which will be called
     for every FUTURE value yielded by x.
     f! MUST NOT BE CALLED with current value of x (if it makes sense for x).
     As such f! MUST NEVER BE CALLED during the -subscribe call.
     Returns a subscription token.")
  (-call-with-immediate-value [x sub f!]
    "If x under subscription (identified by token sub) has a current value, pass it to f!.
     Returns a boolean indicating if there was a current value.
     Must be called right after -subscribe. Later calls have no specified
     behavior.")
  (-unsubscribe [x sub] "Cancels the provided subscription token."))

(extend-protocol Subscribable
  Null
  (-subscribe [n f!] nil)
  (-call-with-immediate-value [n sub f!] false)
  (-unsubscribe [n _] nil)
  cljd.core/Atom
  (-subscribe [a f]
    (let [cb (fn [_ _ _ new-state] (f new-state))]
      (add-watch a cb cb)
      cb))
  (-call-with-immediate-value [a sub f!] (f! @a) true)
  (-unsubscribe [a cb]
    (remove-watch a cb))
  Stream
  (-subscribe [s f]
    (.listen s (fn [x] (f x) nil) .cancelOnError true))
  (-call-with-immediate-value [s sub f!] false)
  (-unsubscribe [s sub]
    (.cancel ^dart:async/StreamSubscription sub))
  Future
  (-subscribe [future f]
    (let [sub (volatile! true)]
      (.then future #(when @sub (f %)))
      sub))
  (-call-with-immediate-value [future sub f!] false)
  (-unsubscribe [future sub]
    (vreset! sub false))
  ; TODO & check if we handle partial order on protocols dispatch
  foundation/ValueListenable
  (-subscribe [vl f]
    (doto #(f (.-value vl))
      (->> (.addListener vl))))
  (-call-with-immediate-value [vl sub f!] (f! (.-value vl)) true)
  (-unsubscribe [vl listener]
    (.removeListener vl listener))
  foundation/Listenable
  (-subscribe [l f]
    (let [vn (volatile! 0)]
      (doto #(f (vswap! vn inc))
        (->> (.addListener l)))))
  (-call-with-immediate-value [l sub f!] false)
  (-unsubscribe [l listener]
    (.removeListener l listener)))

(defprotocol StateLifecycle
  (-build [_ state ctx])
  (-update-state [_ state])
  (-init-state [_ state])
  (-dispose-state [_ state]))

(defn sub
  "Returns a subscribable view on another subscribable or vector of subscribables.
   Values are the result of (apply f v args) for all values v yielded by the
   upstream subscribable (in the case of a vector of subscribable,yielded values are
   vectors of each subscribable most recent value).
   This subscribable generates events only when the resulting value changes."
  [s f & args]
  (if (vector? s)
    (reify
      Subscribable
      (-subscribe [self f!]
        (let [v (volatile! nil)
              _ (vreset! v v)
              n (count s)
              ins (volatile! (vec (repeat n nil)))
              subs (into []
                     (map-indexed
                       (fn [i s]
                         (-subscribe s
                           (fn [x]
                             (let [ins (vswap! ins assoc i x)
                                   prev @v]
                               (when-not (identical? prev v) ; when not init
                                 (let [r (apply f ins args)]
                                   (when (not= r prev)
                                     (vreset! v r)
                                     (f! r)))))))))
                     s)]
          (f! (vreset! v (apply f @ins args)))
          subs))
      (-call-with-immediate-value [self subs f!]
        (let [vtv (volatile! (transient []))
              push! #(vswap! vtv conj! %)
              all-immediates
              (reduce-kv (fn [_ i s]
                           (or (-call-with-immediate-value s (nth subs i) push!)
                             (reduced false)))
                true s)]
          (when all-immediates
            ; TODO take immediate value as seed for deduping
            (f! (persistent! @vtv)))
          all-immediates))
      (-unsubscribe [self subs]
        (dorun (map -unsubscribe s subs))))
    (reify
      Subscribable
      (-subscribe [self f!]
        (let [v (volatile! nil)]
          (vreset! v v)
          (-subscribe s
            (fn [x]
              (let [x (apply f x args)]
                (when (not= x @v)
                  (vreset! v x)
                  (f! x)))))))
      (-call-with-immediate-value [self sub f!]
        ; TODO take immediate value as seed for deduping
        (-call-with-immediate-value s sub #(f! (apply f % args))))
      (-unsubscribe [self sub]
        (-unsubscribe s sub)))))

(deftype InheritedBindings [bindings child]
  :extends (widgets/InheritedModel .child child)
  (isSupportedAspect [this name] true)
  (updateShouldNotify [this prev-this]
    (not= bindings (.-bindings ^InheritedBindings prev-this)))
  (updateShouldNotifyDependent [this prev-this aspects]
    ; aspects is a set of vectors of keywords
    (let [prev-bindings (.-bindings ^InheritedBindings prev-this)]
      (boolean
        (some (fn [ks]
                ; should we rather use identity? No
                (some (fn [k] (not= (prev-bindings k) (bindings k))) ks))
          aspects)))))

(defn- ^:macro-support collect-options
  "Returns [options-map & more]."
  [exprs supported-option?]
  (let [opts (take-while (comp keyword? first) (partition 2 exprs))
        exprs (drop (* 2 (count opts)) exprs)
        opts (into {} (map vec) opts)]
    (doseq [k (keys opts)]
      (when-not (supported-option? k)
        (throw (Exception. (str "Unsupported option: " k)))))
    (cons opts exprs)))

(defn- ^:macro-support camel-kebab [s]
  (str/replace s #"(^[A-Z])|[A-Z]" (fn [[s start]] (cond->> (str/lower-case s) (not start) (str "-")))))

(def ^:private ^:macro-support closest-context `^widgets/BuildContext context#)

(deftype WatchState
         [^:mutable k ^:mutable subscribable
          ^:mutable subscription ^:mutable latest]
  :extends widgets/State
  (initState [state]
    (.initState ^super state)
    (-init-state (.-widget state) state)
    nil)
  (didUpdateWidget [state old-widget]
    (.didUpdateWidget ^super state old-widget)
    (-update-state (.-widget state) state)
    nil)
  (dispose [state]
    (-dispose-state (.-widget state) state)
    (.dispose ^super state))
  (build [state ctx]
    (-build (.-widget state) state ctx))
  cljd.core/IFn
  (-invoke [state x]
    (set! latest x)
    (when (.-mounted state)
      (.setState state (fn []))))
  ^:mixin foundation/Diagnosticable
  (debugFillProperties [this props]
    (.debugFillProperties ^super this props)
    (.add props (foundation/DiagnosticsProperty "subscribable" subscribable))
    (.add props (foundation/DiagnosticsProperty "current value" latest))))

(deftype SummonState [^:mutable latest ^:mutable child]
  :extends widgets/State
  (initState [state]
    (.initState ^super state)
    (set! latest state)
    (set! child nil)
    (-init-state (.-widget state) state)
    nil)
  (didUpdateWidget [state old-widget]
    (.didUpdateWidget ^super state old-widget)
    (-update-state (.-widget state) state)
    nil)
  (dispose [state]
    (-dispose-state (.-widget state) state)
    (set! latest nil)
    (set! child nil)
    (.dispose ^super state))
  (build [state ctx]
    (-build (.-widget state) state ctx)))

(defn ^:macro-support refresh-on-expr [opts &env expr]
  (if (contains? opts :refresh-on)
    (:refresh-on opts)
    (let [closed-overs ((:closed-overs &env) expr)]
      (if (next closed-overs)
        (vec closed-overs)
        ; works for 1 and 0 closed overs
        (first closed-overs)))))

(defn- ^:macro-support destructuring-bound-locals [destructuring-form]
  (letfn [(locals [ts form]
            (cond
              (symbol? form) (conj! ts form)
              (map? form)
              (reduce-kv
                (fn [ts k v]
                  (if (keyword? k)
                    (case (name k)
                      ("flds" "keys" "strs" "syms")
                      (transduce
                        (map #(-> % name symbol (with-meta (meta %))))
                        conj! ts v)
                      "or" ts
                      "as" (conj! ts v))
                    (locals ts k)))
                ts form)
              (vector? form)
              (transduce (comp (filter simple-symbol?) (remove '#{&})) conj! ts form)
              :else (throw (ex-info (str "Unexpected binding form " (pr-str form))
                             {:unexpected-form form
                              :whole-form destructuring-form}))))]
    (-> #{} transient (locals destructuring-form) persistent!)))

(defn ^:macro-support value-sym [ensured-binding]
  (cond
    (map? ensured-binding) (:as ensured-binding)
    (vector? ensured-binding) (peek ensured-binding)
    (simple-symbol? ensured-binding) ensured-binding))

(defn ^:macro-support ensure-value-sym [binding]
  (cond
    (map? binding) (cond-> binding (not (:as binding)) (assoc :as `^::ensured m#))
    (vector? binding)
    (if (= :as (nth binding (- (count binding) 2) nil))
      binding
      (conj binding :as `^::ensured v#))
    (simple-symbol? binding) binding))

(defn ^:macro-support expand-watch
  [&env env binding expr {:as opts
                          :keys [dispose dispose-value]
                          subscribable-binding :as} forms]
  (let [expr (list 'dart/async-barrier expr)
        accessor (:> opts)
        value-accessor (:value> opts)
        dispose (if (true? dispose) '.dispose dispose)
        dispose-value (if (true? dispose-value) '.dispose dispose-value)
        binding (cond-> binding dispose-value ensure-value-sym)
        vsym (value-sym binding)
        _ (assert (if dispose-value vsym true)
            "dispose-value needs a whole value binding")
        bound-locals (destructuring-bound-locals binding)
        bound-locals (-> []  ; put the whole value sym first (if any)
                       (cond-> vsym (conj vsym))
                       (into  (disj bound-locals vsym)))
        [first-bound-local & more-bound-locals] bound-locals
        [pack-sym :as packing-bindings] (when more-bound-locals
                                          [`pack# bound-locals])
        new-val-sym (or pack-sym first-bound-local)
        binding-for-value-disposal (if packing-bindings [vsym] vsym)
        refresh-on (refresh-on-expr opts &env
                     [`(doto ~expr
                         ~(or accessor `->)
                         ~(or dispose `->))
                      (when vsym
                        `(fn [~vsym]
                           (doto ~vsym
                             ~(or value-accessor `->)
                             ~(or dispose-value `->))))])
        ; destructuring may depend on existing locals (for defaults
        ; or even for key names) so we must take this into account
        destructuring-refresh-on
        (refresh-on-expr nil &env `(fn [~binding] ~bound-locals))
        refresh-on
        (cond
          (not (and destructuring-refresh-on refresh-on))
          (or destructuring-refresh-on refresh-on)
          (vector? refresh-on)
          (if (vector? destructuring-refresh-on)
            (into refresh-on destructuring-refresh-on)
            (conj refresh-on destructuring-refresh-on))
          (vector? destructuring-refresh-on)
          (conj destructuring-refresh-on refresh-on)
          :else
          [refresh-on destructuring-refresh-on])
        state `state#
        subscribable `subscribable#
        update-state
        (if-not (or (not (symbol? binding)) (:dedup opts true)
                  accessor value-accessor dispose-value)
          ; simplest case
          state
          ; common case
          (let [[sym-for-accessor & accessor-bindings]
                (when (or accessor value-accessor)
                  `[p#
                    ~binding
                    (-> p#
                      ~(if accessor
                         `(do (-> ~subscribable ~accessor))
                         `->)
                      ~(or value-accessor `->))])
                ; binding has been destructured, either in accessor-bindings or in the arglist
                no-equal-for-vsym (if (-> vsym meta ::ensured)
                                    `(-> next)
                                    `->)]
            `(fn [~(or sym-for-accessor binding)]
               (let [~@accessor-bindings
                     ~@packing-bindings]
                 (->>
                   ~@(->>
                       [(when (:dedup opts true)
                          `(when-not (= (-> ~new-val-sym
                                          ~no-equal-for-vsym)
                                       (-> (.-latest ~state)
                                         ~no-equal-for-vsym))))
                        (when dispose-value
                          `(do ; the do is to make sure we are not inside this disposing let
                             (let [~binding-for-value-disposal (.-latest ~state)]
                               (some-> ~vsym ~dispose-value))))
                        `(~state ~new-val-sym)]
                       rseq (remove nil?)))))))
        subscribe-call
        `(let [update# ~update-state
               sub# (-subscribe ~subscribable update#)]
           (or (-call-with-immediate-value ~subscribable sub# update#)
             (update# ~(:default opts)))
           sub#)]
    `(reify :extends (widgets/StatefulWidget .key ~(:key env))
       :no-meta true
       :name-hint "watch"
       (~'createState [_#] (WatchState nil nil nil nil))
       cljd.flutter/StateLifecycle
       (~'-init-state [_# state#]
        (let [~state ^WatchState state#
              ~subscribable ~expr]
          (doto ~state
            (.-k! ~refresh-on)
            (.-subscribable! ~subscribable)
            (.-subscription! ~subscribe-call))))
       (~'-dispose-state [_# state#]
        (let [state# ^WatchState state#]
          (doto state#
            (.-k! nil)
            ~(if dispose-value
               `(-> .-latest
                 (as-> ~binding-for-value-disposal
                     (some-> ~vsym ~dispose-value)))
               `->)
            (.-latest! nil)
            (-> .-subscribable
              (doto
                  (-unsubscribe (.-subscription state#))
                  ~@(when dispose [`(-> (dart/type-like ~expr) ~dispose)])))
            (.-subscribable! nil)
            (.-subscription! nil))))
       (~'-build [_# state# ctx#]
        (let [~state ^WatchState state#
              ~(cond-> bound-locals
                 (not (next bound-locals)) first) (.-latest ~state)
              ~closest-context ctx#
              ~@(when subscribable-binding
                  [subscribable-binding `(dart/type-like (.-subscribable ~state) ~expr)])]
          (-widget-cont ~(assoc env :key nil :closest-ctx true)
            ~@forms)))
       (~'-update-state [_# state#]
        (let [~state ^WatchState state#
              k# ~refresh-on]
          (when-not (= k# (.-k ~state))
            (doto (.-subscribable ~state)
              (-unsubscribe (.-subscription ~state))
              ~@(when dispose [`(-> (dart/type-like ~expr) ~dispose)]))
            (let [~subscribable ~expr]
              (doto ~state
                (.-k! k#)
                (.-subscribable! ~subscribable)
                (.-subscription! ~subscribe-call)))))))))

(defn ^:macro-support expand-bg-watcher
  [&env env binding expr {:keys [dispose] :as opts} body forms]
  (let [accessor (:> opts)
        dispose (if (true? dispose) '.dispose dispose)
        refresh-on (refresh-on-expr opts &env expr)
        state `state#
        subscribable `subscribable#
        update-state (if accessor
                       `(fn [_#]
                          (let [~binding (-> ~subscribable ~accessor)]
                            ~@body
                            nil))
                       `(fn [x#]
                             (let [~binding x#]
                               ~@body
                               nil)))
        subscribe-call
        `(let [update# ~update-state
               sub# (-subscribe ~subscribable update#)]
           (-call-with-immediate-value ~subscribable sub# update#)
           sub#)]
    `(reify :extends (widgets/StatefulWidget .key ~(:key env))
       :no-meta true
       (~'createState [_#] (WatchState nil nil nil nil))
       cljd.flutter/StateLifecycle
       (~'-init-state [_# state#]
         (let [~state ^WatchState state#
               ~subscribable ~expr]
           (doto ~state
             (.-k! ~refresh-on)
             (.-subscribable! ~subscribable))
           (dart:async/scheduleMicrotask (fn [] (.-subscription! ~state ~subscribe-call)))))
       (~'-dispose-state [_# state#]
         (let [state# ^WatchState state#]
           (doto (.-subscribable state#)
             (-unsubscribe (.-subscription state#))
             ~@(when dispose [`(-> (dart/type-like ~expr) ~dispose)]))
           (doto state#
             (.-k! nil)
             (.-subscribable! nil)
             (.-subscription! nil))))
       (~'-build [_# state# ctx#]
         (let [~closest-context ctx#]
           (-widget-cont ~(assoc env :key nil :closest-ctx true)
                         ~@forms)))
       (~'-update-state [_# state#]
         (let [~state ^WatchState state#
               k# ~refresh-on]
           (when-not (= k# (.-k ~state))
             (doto (.-subscribable ~state)
               (-unsubscribe (.-subscription ~state))
               ~@(when dispose [`(-> (dart/type-like ~expr) ~dispose)]))
             (let [~subscribable ~expr]
               (doto ~state
                 (.-k! k#)
                 (.-subscribable! ~subscribable))
               (dart:async/scheduleMicrotask (fn [] (.-subscription! ~state ~subscribe-call))))))))))

(deftype ResourceState [^:mutable k ^:mutable resource]
  :extends widgets/State
  (initState [state]
    (.initState ^super state)
    (-init-state (.-widget state) state)
    nil)
  (didUpdateWidget [state old-widget]
    (.didUpdateWidget ^super state old-widget)
    (-update-state (.-widget state) state)
    nil)
  (dispose [state]
    (-dispose-state (.-widget state) state)
    (.dispose ^super state))
  (build [state ctx]
    (-build (.-widget state) state ctx))
  ^:mixin foundation/Diagnosticable
  (debugFillProperties [this props]
    (.debugFillProperties ^super this props)
    (.add props (foundation/DiagnosticsProperty "resource" resource))))

(defn ^:macro-support expand-resource
  [&env env binding expr opts forms]
  (let [dispose (or (:dispose opts '.dispose) `comment)
        update (:update opts)
        refresh-on (refresh-on-expr opts &env (if update
                                                `(fn [expr#]
                                                   (-> expr# (dart/type-like ~expr) ~update))
                                                expr))
        expr (list 'dart/async-barrier expr)]
    `(reify :extends (widgets/StatefulWidget .key ~(:key env))
       :no-meta true
       :name-hint "managed"
       (~'createState [_#] (ResourceState nil nil))
       cljd.flutter/StateLifecycle
       (~'-init-state [_# state#]
         (doto ^ResourceState state#
           (.-k! ~refresh-on)
           (.-resource! ~expr)))
       (~'-dispose-state [_# ^ResourceState state#]
        (doto ^ResourceState state#
          (.-k! nil)
          (-> .-resource (dart/type-like ~expr) ~dispose)
          (.-resource! nil)))
       (~'-build [_# ^ResourceState state# ^widgets/BuildContext ctx#]
         (let [~binding (dart/type-like (.-resource ^ResourceState state#) ~expr)
               ~closest-context ctx#]
           (-widget-cont ~(assoc env :key nil :closest-ctx true)
             ~@forms)))
       (~'-update-state [_# ^ResourceState state#]
        (let [k# ~refresh-on]
          (when-not (= k# (.-k state#))
            (doto state#
              ~@(if update
                  [`(as-> state#
                        (let [old-resource# (.-resource state#)
                              new-resource# (-> old-resource# ~update)]
                          (when-not (identical? old-resource# new-resource#)
                            (-> old-resource# ~dispose)
                            (.-resource! state# new-resource#))))]
                  [`(-> .-resource (dart/type-like ~expr) ~dispose)
                   `(.-resource! ~expr)])
              (.-k! k#))))))))

;; Shoulde we merge ResourceState and KeepAliveState in a single
;; map-holding generic class?
(deftype KeepAliveState [^:mutable ^foundation/ChangeNotifier? handle]
  :extends widgets/State
  (initState [state]
    (.initState ^super state)
    (-init-state (.-widget state) state)
    nil)
  (didUpdateWidget [state old-widget]
    (.didUpdateWidget ^super state old-widget)
    (-update-state (.-widget state) state)
    nil)
  (dispose [state]
    (-dispose-state (.-widget state) state)
    (.dispose ^super state))
  (build [state ctx]
    (-build (.-widget state) state ctx))
  ^:mixin foundation/Diagnosticable
  (debugFillProperties [this props]
    (.debugFillProperties ^super this props)
    (.add props (foundation/DiagnosticsProperty "keep-alive" (some? handle)))))

(defn ^:macro-support expand-keep-alive
  [&env env expr forms]
  `(reify :extends (widgets/StatefulWidget .key ~(:key env))
     :no-meta true
     :name-hint "keep-alive"
     (~'createState [_#] (KeepAliveState nil))
     cljd.flutter/StateLifecycle
     (~'-init-state [_# ^KeepAliveState state#])
     (~'-dispose-state [_# ^KeepAliveState state#]
      (when-some [handle# (.-handle state#)]
        (.dispose handle#)
        (.-handle! state# nil)))
     (~'-build [_# ^KeepAliveState state# ^widgets/BuildContext ctx#]
      (let [handle# (.-handle state#)]
        (if ~expr
          (when-not handle#
            (-> (.-handle! state# (foundation/ChangeNotifier))
              widgets/KeepAliveNotification
              (.dispatch ctx#)))
          (when handle#
            (doto handle# .notifyListeners .dispose)
            (.-handle! state# nil))))
      (let [~closest-context ctx#]
        (-widget-cont ~(assoc env :key nil :closest-ctx true)
          ~@forms)))
     (~'-update-state [_# state#])))

(defn get-of
  "Takes a BuildContext, a keyword and optionally a default value.
   Returns the value bound (via :bind) to this keyword.
   DO CREATES A DEPENDENCY. In event handlers, prefer peek-of instead."
  ([ctx k] (get-of ctx k nil))
  ([^widgets/BuildContext ctx k not-found]
   (if-some [inherited-elt (#/(.getElementForInheritedWidgetOfExactType InheritedBindings) ctx)]
     (do
       (.dependOnInheritedElement ctx inherited-elt .aspect [k])
       (get (some-> inherited-elt
              ^InheritedBindings (.-widget)
              .-bindings)
         k not-found))
     not-found)))

(defn peek-of
  "Takes a BuildContext, a keyword and optionally a default value.
   Returns the value bound (via :bind) to this keyword.
   Meant to be used in event handlers.
   DO NOT CREATE A DEPENDENCY. When building widgets prefer :get or get-of."
  ([ctx k] (peek-of ctx k nil))
  ([^widgets/BuildContext ctx k not-found]
   (if-some [inherited-elt (#/(.getElementForInheritedWidgetOfExactType InheritedBindings) ctx)]
     (get (some-> inherited-elt
            ^InheritedBindings (.-widget)
            .-bindings)
       k not-found)
     not-found)))

(defn ^:macro-support get-inherited-type-expr [context type args]
  (let [name (name type)
        has-of (re-find #"(?:\..+Of|\.of)$" name)
        name (cond-> name (not has-of) (str ".of"))]
    (list* (symbol (namespace type) name) context args)))

(defn ^:macro-support get-inherited-keyword-expr [bindings-sym kw args]
  `(->
     (get ~bindings-sym ~kw)
     ~(or (seq args) `->)))

(defn ^:macro-support expand-get-inherited [env v forms]
  (let [inherit (if (vector? v) {:value-of v} v)
        inherit (if-some [shortcuts (:value-of inherit)]
                  (into (dissoc inherit :value-of)
                    (map (fn [type-or-kw]
                           (let [hint (cond-> type-or-kw (seq? type-or-kw) first)]
                             [(symbol
                                (if (keyword? hint)
                                  (name hint)
                                  (camel-kebab
                                    (second (re-find #"([^.]+?)(?:Of|\.of)?$" (name hint))))))
                              type-or-kw])))
                    shortcuts)
                  inherit)
        inherit (into inherit
                  (keep (fn [[k v]] (when-not (seq? v) [k (list v)])))
                  inherit)
        bindings-sym `bindings#
        {inherited-widgets false
         inherited-bindings true}
        (group-by (fn [[sym [type-or-kw]]] (keyword? type-or-kw)) inherit)]
    `(reify :extends (widgets/StatelessWidget .key ~(:key env))
       :name-hint "get"
       :no-meta true
       (~'build [_# ~closest-context]
         (let [~@(mapcat (fn [[sym [type-or-kw & args]]]
                            [sym (get-inherited-type-expr closest-context type-or-kw args)])
                   inherited-widgets)]
          (->>
            (-widget-cont ~(assoc env :key nil :closest-ctx true) ~@forms)
            ~@(when (seq inherited-bindings)
                [`(let [inherited-elt# (#/(.getElementForInheritedWidgetOfExactType InheritedBindings) ~closest-context)
                        ~bindings-sym (some-> inherited-elt#
                                        ^InheritedBindings (.-widget)
                                        .-bindings)
                        ~@(mapcat
                             (fn [[sym [type-or-kw & args]]]
                               [sym (get-inherited-keyword-expr bindings-sym type-or-kw args)])
                             inherited-bindings)]
                    (.dependOnInheritedElement ~closest-context
                      inherited-elt#
                      .aspect ~(into [] (map (fn [[sym [type-or-kw]]] type-or-kw)) inherited-bindings)))])))))))

(defn ^:macro-support expand-summon
  [&env env binding expr {:as opts} forms]
  (let [accessor (or (:value> opts) (:> opts))
        as-sym (:as opts)
        vsym (value-sym binding)
        bound-locals (destructuring-bound-locals binding)
        bound-locals (-> []
                       (cond-> vsym (conj vsym))
                       (into (disj bound-locals vsym)))
        [first-bound-local & more-bound-locals] bound-locals
        [pack-sym :as packing-bindings] (when more-bound-locals
                                          [`pack# bound-locals])
        new-val-sym (or pack-sym first-bound-local)
        state `state#
        source `source#
        value `value#
        next-value `next#
        bindings-sym `bindings#
        inherited-elt `inherited-elt#
        [type-or-kw & args] (if (seq? expr) expr [expr])
         get-expr (if (keyword? type-or-kw)
                    (get-inherited-keyword-expr bindings-sym type-or-kw args)
                    (get-inherited-type-expr nil type-or-kw args))
        get-expr (if (keyword? type-or-kw)
                   `(let [~inherited-elt
                          (#/(.getElementForInheritedWidgetOfExactType InheritedBindings)
                           ~closest-context)
                          ~bindings-sym (some-> ~inherited-elt
                                          ^InheritedBindings (.-widget)
                                          .-bindings)
                          ~source ~get-expr]
                      (.dependOnInheritedElement ~closest-context
                        ~inherited-elt
                        .aspect [~type-or-kw])
                      ~source)
                    (get-inherited-type-expr closest-context type-or-kw args))]
    `(reify :extends (widgets/StatefulWidget .key ~(:key env))
       :no-meta true
       :name-hint "summon"
        (~'createState [_#] (SummonState nil nil))
       cljd.flutter/StateLifecycle
       (~'-init-state [_# state#])
       (~'-dispose-state [_# state#])
       (~'-build [_# state# ctx#]
         (let [~state ^SummonState state#
               ~closest-context ctx#
               ~source ~get-expr
               ~@(when as-sym [as-sym source])
               ~value ~(if accessor `(-> ~source ~accessor) source)
               ~binding ~value
               ~@packing-bindings
               ~next-value ~new-val-sym]
           (if (or (identical? (.-latest ~state) ~state)
                 (not= ~next-value (.-latest ~state)))
             (let [child# (-widget-cont ~(assoc env :key nil :closest-ctx true)
                              ~@forms)]
               (set! (.-latest ~state) ~next-value)
               (set! (.-child ~state) child#)
               child#)
             (.-child ~state))))
       (~'-update-state [_# state#]))))

(deftype Bind [k bindings child]
  :extends (widgets/StatelessWidget .key k)
  (build [_ ctx]
   (let [elt (#/(.getElementForInheritedWidgetOfExactType InheritedBindings) ctx)
         parent-bindings (some-> elt ^InheritedBindings (.-widget) .-bindings)
         non-shadowed-keys (vec (keys (join-with nil identity parent-bindings bindings)))]
     (when (seq non-shadowed-keys)
       (.dependOnInheritedElement ctx elt .aspect non-shadowed-keys))
     (cljd.flutter/InheritedBindings. (merge parent-bindings bindings) child))))

(defn ^:macro-support expand-bind [env bindings-map forms]
  (assert (map? bindings-map) ":bind expects a map")
  `(Bind ~(:key env) ~bindings-map (widget ~@forms)))

(defn ^:macro-support expand-vsync [env name forms]
  `(reify :extends (widgets/StatefulWidget .key ~(:key env))
     :no-meta true
     :name-hint "vsync"
     (~'createState [_#]
      (reify :extends widgets/State
        :no-meta true
        (~'build [state# ctx#]
         (-build (.-widget state#) state# ctx#))
        ^:mixin widgets/TickerProviderStateMixin))
     StateLifecycle
     (~'-build [_# state# ~closest-context]
      (let [~(vary-meta name assoc :tag `widgets/TickerProvider) state#]
         (-widget-cont ~(assoc env :key nil :closest-ctx true) ~@forms)))))


(defn ^widgets/EdgeInsetsGeometry edge-insets-geometry [x]
  (cond
    (instance? widgets/EdgeInsetsGeometry x)
    x
    (number? x) (widgets/EdgeInsets.all x)
    :else
    (let [{:keys [top bottom left right start end horizontal vertical]} x
          horizontal (or horizontal 0.0)
          vertical (or vertical 0.0)]
      (if (or start end)
        (widgets/EdgeInsetsDirectional.fromSTEB
          (or start horizontal) (or top vertical) (or end horizontal) (or bottom vertical))
        (widgets/EdgeInsets.fromLTRB
          (or left horizontal) (or top vertical) (or right horizontal) (or bottom vertical))))))

(defn ^:macro-support expand-padding [env padding forms]
  `(widgets/Padding
     .key ~(:key env)
     .padding (edge-insets-geometry ~padding)
     .child (-widget-cont ~(assoc env :key nil :closest-ctx false) ~@forms)))

(defn ^:macro-support expand-color [env color forms]
  `(widgets/ColoredBox
     .key ~(:key env)
     .color ~color
     .child (-widget-cont ~(assoc env :key nil :closest-ctx false) ~@forms)))

(defn ^:macro-support expand-visible [env visible forms]
  `(if ~visible
     (-widget-cont ~env ~@forms)
     (widgets/SizedBox.shrink .key ~(:key env))))

(defn ^:macro-support expand-height-width [env forms]
  (let [dims (take-while (fn [[k]] (case k (:height :width) true false)) (partition 2 forms))
        forms (drop (* 2 (count dims)) forms)
        {:keys [height width]} (reduce (fn [m [k v]] (assoc m k v)) {} dims)]
    `(widgets/SizedBox
       .key ~(:key env)
       .width ~width
       .height ~height
       .child (-widget-cont ~(assoc env :key nil :closest-ctx false) ~@forms))))

(defprotocol ITweenable
  (-tween [end]))

(extend-protocol ITweenable
  fallback ; supports types like double, offsets which defines + and uses * as a scaling operator
  (-tween [end] (widgets/Tween .end end))

  widgets/AlignmentGeometry
  (-tween [end] (widgets/AlignmentGeometryTween .end end))

  widgets/Alignment
  (-tween [end] (widgets/AlignmentTween .end end))

  widgets/BorderRadius
  (-tween [end] (widgets/BorderRadiusTween .end end))

  widgets/Border
  (-tween [end] (widgets/BorderTween .end end))

  widgets/BoxConstraints
  (-tween [end] (widgets/BoxConstraintsTween .end end))

  widgets/Color
  (-tween [end] (widgets/ColorTween .end end))

  widgets/Decoration
  (-tween [end] (widgets/DecorationTween .end end))

  widgets/EdgeInsetsGeometry
  (-tween [end] (widgets/EdgeInsetsGeometryTween .end end))

  widgets/EdgeInsets
  (-tween [end] (widgets/EdgeInsetsTween .end end))

  widgets/FractionalOffset
  (-tween [end] (widgets/FractionalOffsetTween .end end))

  int
  (-tween [end] (widgets/IntTween .end end))

  widgets/Matrix4
  (-tween [end] (widgets/Matrix4Tween .end end))

  widgets/Rect
  (-tween [end] (widgets/RectTween .end end))

  widgets/RelativeRect
  (-tween [end] (widgets/RelativeRectTween .end end))

  material/ShapeBorder
  (-tween [end] (material/ShapeBorderTween .end end))

  widgets/Size
  (-tween [end] (widgets/SizeTween .end end))

  widgets/TextStyle
  (-tween [end] (widgets/TextStyleTween .end end))

  material/ThemeData
  (-tween [end] (material/ThemeDataTween .end end)))

(defn lerp
  "Returns the default interpolation function (taking one argument t from 0.0 to 1.0)
   for provided values."
  [from to]
  (.-lerp (doto ^widgets/Tween (-tween to) (.-begin! from))))

(deftype CustomTween [f ^:mutable lerpf]
  :extends widgets/Tween
  (begin [this v] (set! lerpf nil) (.-begin! ^super this v))
  (end [this v] (set! lerpf nil) (.-end! ^super this v))
  (lerp [this t]
    (let [lerpf (or lerpf (set! lerpf (f (.-begin this) (.-end this))))]
      (lerpf t))))

(defn ^widgets/Tween tween-with
  "Create a tween ending at the provided value. Or return the value if it's already a tween.
   When f is not provided, a tween is created using the ITweenable protocol.
   When f is provided it must be a function of two args (begin and end values),
   returning an interpolation function from t (between 0.0 and 1.0) to
   interpolated value."
  [f end]
  (cond
    f
    (doto (CustomTween f nil)
      (.-end! end))
    (instance? widgets/Tween end) end
    :else
    (-tween end)))

(defn ^:macro-support expand-animate
  [&env env binding expr {:keys [lerp on-end duration curve] :as opts
                          :or {duration `(Duration .milliseconds 500)
                               curve `widgets/Curves.linear}} forms]
 `(widgets/TweenAnimationBuilder
    .key ~(:key env)
    .tween (tween-with ~lerp ~expr)
    .duration ~duration
    .curve ~curve
    .onEnd ~(when on-end `(fn [] ~on-end nil))
    .builder
    (fn [~closest-context ~binding _#]
      (-widget-cont ~(assoc env :key nil :closest-ctx true) ~@forms))))

(deftype SpyWidget [k child f]
  :extends (widgets/StatelessWidget .key k)
  (build [_ _] child)
  (debugFillProperties [this props-builder]
    (.debugFillProperties ^super this props-builder)
    (f props-builder)
    nil))

(defn ^:macro-support expand-spy [env expr forms]
  `(SpyWidget ~(:key env) (-widget-cont ~(assoc env :key nil) ~@forms)
     (fn [^foundation/DiagnosticPropertiesBuilder props-builder#]
       (.add props-builder# (foundation/DiagnosticsNode.message (.toString ~expr))))))

(defmacro widget
  "Returns a widget.
   The body is made of forms, dotted parameter names and directives.
   A directive is a keyword followed by a form.
   The following directives are supported:
   :key, :let, :get, :summon, :bind, :vsync, :managed, :keep-alive, :watch, :bg-watcher,
   :spy, :context, :builder (and all keywords ending with Builder).

   Forms and directives are threaded (a bit like with ->>) to nest them.
   The outermost form comes first.

   For example:
   (widget m/Center ...) expands to (m/Center .child (widget ...))
   (widget (m/Center .widthFactor 1.1)  ...) expands
   to (m/Center .widthFactor 1.1 .child (widget ...))
   .child threading is the default but you can opt to choose another param name:
   (widget (m/Scaffold .appBar (m/AppBar)) .body ...) expands
   to (m/Scaffold .appBar (m/AppBar) .body (widget ...))

   If a threading property has metadata :builder on then the body will be thread as
   a builder.

   For example:
   (widget
     (m/ListView.builder .itemCount 123)
     ^:builder .itemBuilder [i] ; context is implicit and retrieved by :context when needed
     :height 48
     (m/Text (str i)))
   is equivalent to:
   (m/ListView.builder
     .itemCount 123
     .itemBuilder (f/build [i]
                    :height 48
                    (m/Text (str i))))
   However when the builder propname ends with builder one can write:
   (widget
     (m/ListView.builder .itemCount 123)
     :itemBuilder [i]
     :height 48
     (m/Text (str i)))

   Directives:
   :key k -- use k (a regular value, nil even!) as the key for this widget.
     It's important to put a key on widgets when they can be reordered and/or the
     siblings count is not set.
   :let [bindings] -- just a regular let, all bindings are visible to the next
     forms.
   :bypass other-widget-or-falsey -- provides an alternative path that bypasses the
     nominal body.
     If the value passed to :bypass is neither nil or false, it is returned immediately
     and the rest of the widget body is not evaluated.
     Otherwise, evaluation continues normally.
     This is intended for non-nominal cases (e.g. loading states, placeholders,
     empty states), where the main path should be skipped.
   :get [SomeClass1 ... SomeClassN]
     -- shortcut for :get {:value-of [SomeClass1 ... SomeClassN]}
   :get {a AClass b :some/name :value-of [AnotherClass SomeClass.somePropOf]} -- introduces a, b, another-class (kebab-cased version of AnotherClass) and some-prop (kebab-cased version of somePropOf) in the local scope for
     next forms. a and b may be destructuring forms.
     They are bound to:
     - for classes (eg AClass and AnotherClass) to the value returned by
       their static .of method.
       For example :get [m/Theme] binds theme to (m/Theme.of ctx).
     - for keywords to the value set by the closest matching :bind directive in
       the widget's ancestors.
     Last, when .of (or the explicit method) expects more arguments (eg Localizations) then you can pass
     these argument by by using (ClassName a b c) instead of just ClassName.
     Prefer :summon for new code. :get is retained for compatibility.
   :bind {:some/name value} -- makes value available to :get {x :some/name} on
     all descendants.
   :vsync name -- bind name to a TicketProvider suitable for animation.
   :managed [bindings] -- evaluate bindings as per let but with a twist.
     The twist is that each \"binding expr\" pair can be followed by options pairs \":keyword expr\".
     Under :managed each value is going to be managed (that is its lifecycle will
     be tied to the widget) and will be disposed in due time by a call to
     its .dispose method.
     Supported options are :refresh-on and :dispose.
     - :dispose form -- specify how to properly dispose the managed resource.
       Defaults to `.dispose`.
       Will be evaluated as (-> resource form) unless form is `nil` or `false`
       in which case, the resource won't be disposed (just garbage collected).
     - `:update form` -- customizes how the resource is refreshed.
       By default, resources are disposed and recreated.
       With `:update`, `(-> resource form)` is evaluated to produce
       an updated resource. If the returned resource is not identical
       to the original, the old one is disposed.
     - :refresh-on expr -- the managed resource will be cycled (disposed and
       recreated) each time expr evaluates to a new value.
       Default behavior is to refresh-on on all locals (free variables) used by
       the resource creation expr or the update form (which takes precedence).
       Use `:refresh-on :never` to avoid refreshing (or any other constant
       instead of :never).
   :watch [bindings] -- for each \"binding expr\" pair, subscribe to expr and
     use binding to bind each value received under the subscription. A rebuild
     is triggered only when bound values change (according to equality).
     So when binding is a destructuring form, the rebuild is triggered only
     when locals bound by the destructuring do change, allowing to watch only
     parts of the value.
     Any object to which the Subscribable protocol has been extended can be
     watched.
     Out of the box it means: atoms, Streams, Futures, Listenables,
     ValueListenable and... nil.
     These bindings can take options (in the same way as :managed bindings do).
     Supported options are
     - :as -- gives a name to the watched resource (e.g. to be able to swap! on
       it if it's an atom)
     - :default -- provides an interim value to use while the first actual value
       is available (e.g. while waiting for a Future to complete or a Stream to
       produce a value). Useless when the watched resource can provide a current
       value (atoms for example).
     - :refresh-on expr -- see :managed
     - :dispose form -- if the object under watch also needs to be managed use
       this option. Works like :dispose for :managed except for \":dispose true\"
       which is a shortcut for \":dispose .dispose\".
     - :dispose-value form -- if the produced  values need to be managed use
       this option. Works like :dispose for :managed except for \":dispose-value true\"
       which is a shortcut for \":dispose .dispose\".
     - :dedup boolean -- defaults to true, set it to false to rebuild on every
       change
     - :value> form -- transform produced values as per (-> produced-value form),
       this is useful to preprocess values before destructuring/deduping.
     - :> form -- this one is meant to be used with Listenable instances because
       they don't produce values, just a change notification. So if this option
       is not used you only get trues from the subscription.
       When this option is set then values are produced by evaluating
       (-> subscribable form).
     :summon [binding rhs & options] -- resolves a class through its `.of` method,
       a keyword through the nearest :bind, or a form with explicit arguments,
       on every build. It then binds or destructures the resulting value. The
       body is evaluated only when the bound value changes; otherwise the
       previously created child is returned. :as binds the raw RHS value. The
       only other supported options are :> and :value>, which are equivalent and
       both transform the RHS value before binding or destructuring. :default,
       :refresh-on, :dedup and disposal options are not supported.
   :bg-watcher ([binding expr & options] body) -- creates a background watcher on
     expr (which must be subscribable, see :watch). Same options as :watch are
     supported.
     Main differences from :watch are:
     - does not trigger rebuilds
     - bindings are only visible in the body of the watcher, not to the rest of
       the widget.
   :keep-alive expr -- when expr is true, notify the AutomaticKeepAlive ancestor
     that it must keep the widget tree alive.
     See https://api.flutter.dev/flutter/widgets/KeepAlive-class.html for more
     information and the contexts in which an AutomaticKeepAlive ancestor is
     implicitely created.
   :spy expr -- make expr's value available into Flutter DevTools.
   :context name -- bind name to the current BuildContext.
   :padding p -- p can be either: a EdgeInsetsGeometry instance, a number
     (applied to all four directions) or a map with keys :left :right :top
     :bottom :start :end :horizontal :vertical. If either :start or :end are
     non-nil then :left and :right are ignored. :vertical and :horizontal have
     e lesser precedence than the others.
   :color c -- specify the background color; shorthand for (ColoredBox .color c ...)
   :width w
   :height h -- specify width and and height shorthands for SizedBox
   :when test -- when test is falsy the subsequent widget is replaced by an empty widget (m/SizedBox.shrink)
   :animate [binding expr & options] -- animate changes to `expr` value; during
     animation, at each frame an interpolated value between the previous value
     :of `expr` and the new one is bound to `binding`. Supported options are:
     - :duration d -- the animation length as a Duration instance (500ms by default),
     - :curve c -- the Curve instance used to interpolate between values (Curves.linear by default).
     - :on-end expr -- expr is evaluated when the animation reaches its end.
     - :lerp f -- to provide custom interpolation, f must be a function of two args (from and to)
       returning a function of t (a double usually between 0.0 and 1.0 but some Curve instances can
       generate values out of this range, see Curves.easeInOutBack for example).
     Default interpolation is provided by cljd.flutter/lerp for many types:
     int, double, Offset, Size, TextStyle, Color... and can be extended via the ITweenable protocol.
   :builder [arg1 .. argN] -- equivalent to `.builder (f/build [arg1 .. argN] remaining body)` without the nesting
   :.+Builder [arg1 .. argN] -- like :builder but for any symbol ending with Builder; see ^:builder metadata on
     threaded symbols too."
  [& body]
  (with-meta
    `(-widget-cont {} ~@body)
    (meta &form)))

(defn- ^:macro-support stateless-flush [env forms]
  `(reify :extends (widgets/StatelessWidget .key ~(:key env))
     :name-hint "widget"
     :no-meta true
     (~'build [_# ~closest-context]
      (-widget-cont ~(assoc env :key nil :closest-ctx true) ~@forms))))

(deftype GlobalValueKey [value]
  :extends (widgets/GlobalKey.constructor)
  ^:mixin cljd.core/ToStringMixin
  ^:mixin cljd.core/EqualsEquivMixin
  cljd.core/IEquiv
  (-equiv [x y]
    (and (instance? GlobalValueKey y)
      (= value (.-value ^GlobalValueKey y))))
  cljd.core/IHash
  (-hash [x] (hash-combine 0x7d5cf3dd (hash value)))
  cljd.core/IPrint
  (-print [o sink]
    (doto ^StringSink sink
      (.write "#object[cljd.flutter.GlobalValueKey ")
      (->> (-print value))
      (.write "]"))))

(defn global-key
  "Returns a global key with value semantics."
  ; for const
  {:inline (fn [vexpr] `(GlobalValueKey ~vexpr))
   :inline-arities #{1}}
  [v]
  (GlobalValueKey v))

(defn ^:macro-support expand-repl-point
  [&env env _ forms]
  (let [userk (:key env)
        ksym-or-nil (when userk `k#)]
    `(let [~@(when ksym-or-nil
               [ksym-or-nil `(when-not foundation/kDebugMode
                               ~userk)])
           child# (-widget-cont ~(assoc env :key ksym-or-nil) ~@forms)]
       (if foundation/kDebugMode
         (-widget-cont+ctx ; ensures we have a context and the key is flushed
           ~env
           (cond->> child#
             (get-of ~closest-context ::repl)
             (ReplPointWidget
               ~(-> (select-keys (meta (first forms)) [:line :column])
                  (assoc :ns `'~(-> &env :nses :current-ns)))
               (fn []
                 (apply hash-map
                   ~(tagged-literal 'dart
                        (into [] (mapcat (fn [x]
                                           (when (and (simple-symbol? x)
                                                   #_(re-matches #"\$|[^$]+" (name x)))
                                             [`'~x x])))
                          (keys (dissoc &env '_)))))
                 ; 👇 emits too much code, hence ☝️
                 #_~(into {}
                      (keep (fn [x]
                              (when (and (simple-symbol? x)
                                      #_(re-matches #"\$|[^$]+" (name x)))
                                [`'~x x])))
                      (keys (dissoc &env '_)))))))
         child#))))

(defn- ^:macro-support expand-directive [&env env k v form & more-forms]
  (let [ksym `k#
        forms (cons form more-forms)]
    (case k
      :key `(let [~ksym (foundation/ValueKey ~v)]
              (-widget-cont ~(assoc env :key ksym) ~@forms))
      :global-key `(let [~ksym (GlobalValueKey ~v)]
                     (-widget-cont ~(assoc env :key ksym) ~@forms))
      :-impl-repl-point (expand-repl-point &env env v forms)
      :let `(let ~v (-widget-cont ~env ~@forms))
      :bypass `(or ~v (-widget-cont ~env ~@forms))
      :watch
      (if-some [[binding expr & more] (seq v)]
       (let [[opts & more] (collect-options more
                              #(or (qualified-keyword? %)
                                 (#{:default :refresh-on :dispose :> :as
                                    :value> :dispose-value :dedup} %)))]
          (expand-watch &env env binding expr opts (list* :watch more forms)))
        `(-widget-cont ~env ~@forms))
       :summon
       (if-some [[binding expr & more] (seq v)]
        (let [[opts & more] (collect-options more
                               #(or (qualified-keyword? %)
                                  (#{:> :value>} %)))]
          (expand-summon &env env binding expr opts (list* :summon more forms)))
        `(-widget-cont ~env ~@forms))
      :managed
      (if-some [[binding expr & more] (seq v)]
        (let [[opts & more] (collect-options more  #{:dispose :refresh-on :update})]
          (expand-resource &env env binding expr opts (list* :managed more forms)))
        `(-widget-cont ~env ~@forms))
      :keep-alive
      (expand-keep-alive &env env v forms)
      :bg-watcher
      (let [[[binding expr & more] & body] (seq v)
            [opts & more] (collect-options more
                            #(or (qualified-keyword? %)
                               (#{:refresh-on :dispose :>} %)))]
        (when more
          (throw (Exception. "Extra forms found after options.")))
        (expand-bg-watcher &env env binding expr opts body forms))
      :bind (expand-bind env v forms)
      :get (expand-get-inherited env v forms)
      :context
      (if (:closest-ctx env)
        `(let [~v ~closest-context] (-widget-cont ~env ~@forms))
        (stateless-flush env (list* :context v forms)))
      :spy (expand-spy env v forms)
      :vsync (expand-vsync env v forms)
      :padding (expand-padding env v forms)
      :color (expand-color env v forms)
      (:height :width) (expand-height-width env (list* k v forms))
      :when (expand-visible env v forms)
      :animate
      (if-some [[binding expr & more] (seq v)]
        (let [[opts & more] (collect-options more #{:duration :curve :on-end :lerp})]
          (expand-animate &env env binding expr opts (list* :animate more forms)))
        `(-widget-cont ~env ~@forms)))))

(defn ^:macro-support ensure-repl-point-after-directives [directive [op :as forms]]
  (cond->> forms
    (and (not= :-impl-repl-point directive) (not (keyword? op)) (seq forms))
    (list* :-impl-repl-point nil)))

(defmacro -widget-cont+ctx
  "PRIVATE DONT USE"
  [env & forms]
  (if (:closest-ctx env)
    `(-widget-cont ~env ~@forms)
    (stateless-flush env forms)))

(defmacro -widget-cont
  "PRIVATE DONT USE"
  [env form & more-forms]
  (let [[last-maybe-prop last-expr] (take-last 2 more-forms)]
    (cond
      (and (-> &form meta ::threaded-in) (not (symbol? last-expr)))
      `(let [threaded-in-form# ~last-expr]
         (-widget-cont ~env ~form ~@(drop-last 2 more-forms)
           ~last-maybe-prop
           threaded-in-form#))
      (simple-keyword? form)
      (let [[options & more-forms] more-forms]
        (apply expand-directive &env env form options
          (ensure-repl-point-after-directives form more-forms)))
      (:key env)
      (stateless-flush env (cons form more-forms))
      (qualified-keyword? form)
      (let [[options & more-forms] more-forms]
        `(-widget-cont ~env (~(symbol form) ~options) ~@(ensure-repl-point-after-directives form more-forms)))
      (nil? more-forms) form
      (= '.child form) ; for nested f/widgets ending by a directive
      `(-widget-cont ~env ~@more-forms)
      (symbol? form)
      `(-widget-cont ~env ~(with-meta (list form) (meta form)) ~@more-forms)
      (seq? form)
      (let [[maybe-prop] more-forms
            [prop & more-forms]
            (cond
              (and more-forms (simple-symbol? maybe-prop)
                (.startsWith (name maybe-prop) ".")
                (not (-> maybe-prop meta :builder)))
              more-forms
              (and more-forms
                (or (and simple-symbol? (-> maybe-prop meta :builder))
                  (and (simple-keyword? maybe-prop)
                    (re-matches #"(?:b|.+B)uilder" (name maybe-prop)))))
              (do
                (assert (vector? (second more-forms)))
                [(if (keyword? maybe-prop)
                   (symbol (str "." (name maybe-prop)))
                   maybe-prop)
                 `(build ~@(next more-forms))])
              :else
              (cons '.child more-forms))
            env (dissoc env :closest-ctx)]
        (-> `(~@form ~prop
              (-widget-cont ~env ~@more-forms))
          (with-meta (assoc (meta form) ::threaded-in true))))
      :else (throw (ex-info (str "Unexpected widget form: " (pr-str form)) {:form form :more-forms more-forms})))))

(defmacro build
  "Generates a so-called \"builder\" function, that is a widget-returning function which expects 1+ arguments, where the first argument is a BuildContext. (Such fns are expected for example as the .itemBuilder param to ListView/builder)
  `argsvec` is the argument vector, without the BuildContext. If argsvec is empty it can be omitted.
  After the `argsvec` comes a body, interpreted as per the `widget` macro."
  [argsvec? & body]
  (if (vector? argsvec?)
    `(fn ^widgets/Widget [~closest-context ~@argsvec?] (-widget-cont {:closest-ctx true} ~@body))
    `(fn [~closest-context] (-widget-cont {:closest-ctx true} ~argsvec? ~@body))))

(deftype ReplPointWidget [source-loc get-envmap child]
  :extends (widgets/StatefulWidget)
  (createState [_]
    (ReplState {})))

(deftype ReplState [^:mutable m]
  :extends #/(widgets/State ReplPointWidget)
  (build [state ctx]
    (when-not (:*active-state m)
      (set! m
        (assoc m :*active-state
          (if-some [{{:keys [*active-state]} .-m}
                    (#/(.findAncestorStateOfType ReplState) ctx)]
            *active-state
            (when-not (:disabled m) (atom state))))))
    (or (:child m)
      (-> state ^ReplPointWidget (.-widget) .-child)))
  (reassemble [state]
    #_(assert (not (when (:disabled m) (identical? state @(:*active-state m)))))
    (.reassemble ^super state)
    (let [{active-is-mounted .-mounted :as active-state}  ^widgets/State @(:*active-state m)
          is-active (identical? state active-state)]
      (assert (or active-is-mounted (not is-active)))
      (when (or is-active (not active-is-mounted))
        (when-not active-is-mounted
          (-> (global-key ::app-root) .-currentContext (peek-of :cljd.flutter.repl-impl/armed)
            (reset! false))
          (reset! (:*active-state m) state))))))

;; Approximate device screen corner radius (logical px) for clipping picker highlights.
(def ^:private +screen-corner-radius+ 42.0)

;; Suppresses debug-paint flags while painting the tools; restored post-frame so the app keeps its guides.
(deftype ^:private NoDebugPaintRender []
  :extends (rendering/RenderProxyBox)
  (paint [this context offset]
    (when (or rendering/debugPaintSizeEnabled rendering/debugRepaintRainbowEnabled
              rendering/debugPaintBaselinesEnabled rendering/debugPaintPointersEnabled)
      (let [a rendering/debugPaintSizeEnabled
            b rendering/debugRepaintRainbowEnabled
            c rendering/debugPaintBaselinesEnabled
            d rendering/debugPaintPointersEnabled]
        (set! rendering/debugPaintSizeEnabled false)
        (set! rendering/debugRepaintRainbowEnabled false)
        (set! rendering/debugPaintBaselinesEnabled false)
        (set! rendering/debugPaintPointersEnabled false)
        (widgets/WidgetsBinding.instance.addPostFrameCallback
          (fn [_]
            (set! rendering/debugPaintSizeEnabled a)
            (set! rendering/debugRepaintRainbowEnabled b)
            (set! rendering/debugPaintBaselinesEnabled c)
            (set! rendering/debugPaintPointersEnabled d)
            nil))))
    (.paint ^super this context offset)
    nil))

(deftype ^:private NoDebugPaint [^widgets/Widget inner]
  :extends (widgets/SingleChildRenderObjectWidget .child inner)
  (createRenderObject [_ _ctx] (NoDebugPaintRender)))

;; (reset! cljd.flutter/+cljd-toolbar-hidden+ true) hides the dev toolbar.
(defonce +cljd-toolbar-hidden+ (atom false))

;; Picker armed flag, toggled by the toolbar pick button and the REPL.
(defonce +cljd-armed+ (atom false))

;; Picked widgets: a vector of pick maps, toggled by tap (dedup by rect).
(defonce +cljd-picks+ (atom []))

;; Host pings ext.cljd.ping ~1/s; a 3s watchdog resets this to false when pings stop.
(defonce +cljd-connected+ (atom false))
(defonce ^:private +cljd-conn-timer+ (atom nil))

;; On-device error store; identical consecutive errors coalesce into one entry with :count.
(defonce +cljd-errors-local+ (atom []))
(defonce ^:private +cljd-error-expanded+ (atom nil))   ; index of the expanded error row, or nil

;; Changes in one event-loop turn flush as one cljd.tx on a microtask (post-frame may never pump).
(defonce ^:private +cljd-recording?+ (atom false))
(defonce ^:private +cljd-tx-buffer+ (atom {}))            ; id → value, pending this turn
(defonce ^:private +cljd-tx-flush-scheduled+ (atom false))
(defonce ^:private +cljd-replaying+ (atom false))         ; true while a host write-state applies (no echo)
(defonce ^:private +cljd-tx-cause+ (atom nil))            ; optional label attached to the next tx

(def ^:private +pick-colors+
  [0xFF00E676 0xFF40C4FF 0xFFFFAB40 0xFFFF4081 0xFFB388FF 0xFFFFEB3B])
(defn- pick-color [i] (widgets/Color (nth +pick-colors+ (mod i (count +pick-colors+)))))
(def ^:private +go+ (widgets/Color 0xFF00E676))    ; primary green accent (repeated)
(def ^:private +cyan+ (widgets/Color 0xFF40C4FF))  ; pick / hover accent (repeated)
(defn- rect-key [^widgets/Rect r] [(.-left r) (.-top r) (.-right r) (.-bottom r)])

(defn- device-metrics
  "{:w :h :dpr} from the FlutterView (no MediaQuery above MaterialApp)."
  []
  (try (let [v (.-implicitView (.-platformDispatcher (widgets/WidgetsBinding.instance)))
             dpr (.-devicePixelRatio v) s (.-physicalSize v)]
         {:w (/ (.-width s) dpr) :h (/ (.-height s) dpr) :dpr dpr})
       (catch Object _ {:w 400.0 :h 800.0 :dpr 2.0})))
(defn- remove-pick! [p]
  (let [k (rect-key (:rect p))]
    (swap! +cljd-picks+ (fn [ps] (vec (remove #(= (rect-key (:rect %)) k) ps))))))

(defn- short-src-path
  "file:///…/lib/cljd-out/a/b.dart → a/b.dart."
  [^String file]
  (let [i (.indexOf file "/cljd-out/")]
    (if (neg? i) file (subs file (+ i 10)))))

(defn- parse-creation-loc
  "Inspector node JSON J → {:src \"a/b.dart:NN\" :name …} from its creationLocation, or nil."
  [^String j]
  (let [fi (.indexOf j "\"file\":\"")]
    (when-not (neg? fi)
      (let [fs (+ fi 8)
            fe (.indexOf j "\"" fs)
            file (subs j fs fe)
            li (.indexOf j "\"line\":" fe)
            ls (+ li 7)
            le (loop [e ls]
                 (if (and (< e (count j))
                          (let [ch (.codeUnitAt j e)] (and (>= ch 48) (<= ch 57))))
                   (recur (inc e)) e))
            ni (.indexOf j "\"name\":\"" fe)
            nm (when-not (neg? ni)
                 (let [ns (+ ni 8)] (subs j ns (.indexOf j "\"" ns))))]
        (when (> le ls)
          {:src (str (short-src-path file) ":" (subs j ls le)) :name nm})))))

(defn- inspector-node
  "Selects EL and returns its inspector node JSON: nearest app-authored node if SUMMARY?, else EL's own."
  [^widgets/Element el summary?]
  (let [svc widgets/WidgetInspectorService.instance]
    (when (.isWidgetCreationTracked svc)
      (.setSelection svc el "cljd-pick")
      (str (if summary?
             (.getSelectedSummaryWidget svc nil "cljd-pick")
             (.getSelectedWidget svc nil "cljd-pick"))))))

(defn- pick-widget-loc
  "Creation loc {:src :name} of the nearest app-authored widget at TARGET, or nil."
  [^widgets/Element target]
  (try (some-> (inspector-node target true) parse-creation-loc) (catch Object _ nil)))

(defonce ^:private +cljd-ext-registered+ (atom false))

(defn- jstr
  "A JSON value literal: jsonEncode a string (quotes + escapes it), or \"null\"."
  [v]
  (if (nil? v) "null" (convert/jsonEncode v)))

(defn- picks->json
  "Picks as {\"picks\":[…]}: service-extension results must be JSON objects, not arrays."
  []
  (str "{\"picks\":["
       (apply str
         (interpose ","
           (map-indexed
             (fn [i p]
               (str "{\"n\":" (inc i)
                    ",\"type\":" (jstr (:type p))
                    ",\"wloc\":" (jstr (:src (:widget-loc p)))
                    ",\"cljd\":" (jstr (:cljd p))
                    ",\"resolved\":" (if (:resolved? p) "true" "false")
                    ",\"scope\":" (jstr (str (:ns (:scope-loc p)) ":" (:line (:scope-loc p))))
                    "}"))
             @+cljd-picks+)))
       "]}"))

(defn- post-event!
  "Posts event KIND to the host; FRAGMENTS maps string keys to JSON-encoded values."
  [kind fragments]
  (try
    (dev/postEvent kind
      (convert/jsonDecode
        (str "{" (apply str (interpose "," (map (fn [e] (str (convert/jsonEncode (key e)) ":" (val e))) fragments))) "}")))
    nil (catch Object _ nil)))

(defn- tap->host
  "Tap fn: streams each tapped value to the host as EDN over cljd.tap."
  [x]
  (post-event! "cljd.tap" {"edn" (convert/jsonEncode (pr-str x))}))

(defn log!
  "Sends a structured event to the host over cljd.log: (log! {:event ::save :ok true})."
  [event-map]
  (post-event! "cljd.log" {"edn" (convert/jsonEncode (pr-str event-map))}))

(defn record!
  "Value-flow probe for `(trace 'form)`: posts form COORD and V over cljd.trace, returns V."
  [coord v]
  (post-event! "cljd.trace" {"coord" (convert/jsonEncode coord) "value" (convert/jsonEncode (pr-str v))})
  v)

(defn report-error!
  "Reports an error to the host (cljd.error) and the on-device error panel.
   PHASE is a short tag (\"flutter\"/\"async\"/\"runtime\"…)."
  ([msg] (report-error! "runtime" msg nil))
  ([phase msg stack]
   (let [e {:phase (str phase) :message (str msg) :stack (str (or stack ""))}]
     ;; deferred: called mid-build from FlutterError.onError, a sync swap! would setState during build
     (dart:async/scheduleMicrotask
       (fn []
         (swap! +cljd-errors-local+
           (fn [es] (let [prev (peek es)]
                      (if (and prev (= (:message prev) (:message e)))
                        (conj (pop es) (update prev :count inc))
                        (vec (take-last 25 (conj es (assoc e :count 1))))))))
         nil))
     (post-event! "cljd.error"
       {"phase" (convert/jsonEncode (:phase e))
        "message" (convert/jsonEncode (:message e))
        "stack" (convert/jsonEncode (:stack e))}))))

(declare arm-recording!)

(defn register-cljd-devtools!
  "Registers cljd dev-tool service extensions and error hooks, once."
  []
  (when (compare-and-set! +cljd-ext-registered+ false true)
    (dev/registerExtension "ext.cljd.picks"
      (fn [_method _params]
        (dart:async/Future.value
          (dev/ServiceExtensionResponse.result (picks->json)))))
    ;; host pushes a resolved .cljd loc onto the pick matching "src" (its Dart wloc)
    (dev/registerExtension "ext.cljd.set-cljd"
      (fn [_method params]
        (let [src (get params "src") cljd (get params "cljd")
              ^String tree (get params "tree")          ; "\n"-joined cljd locs, index-aligned to :ancestors
              tcljds (when (and tree (seq tree)) (vec (.split tree "\n")))]
          (swap! +cljd-picks+
            (fn [ps] (mapv (fn [p]
                             (if (= (:src (:widget-loc p)) src)
                               ;; :resolved? marks the round-trip done; :cljd nil = non-cljd Dart
                               (assoc p :resolved? true :cljd (when (seq cljd) cljd)
                                      :ancestors (vec (map-indexed
                                                        (fn [i a]
                                                          (if-some [c (and tcljds (nth tcljds i nil))]
                                                            (assoc a :cljd (when (seq c) c))
                                                            a))
                                                        (:ancestors p))))
                               p)) ps))))
        (dart:async/Future.value (dev/ServiceExtensionResponse.result "{\"ok\":true}"))))
    (dev/registerExtension "ext.cljd.ping"
      (fn [_method _params]
        (reset! +cljd-connected+ true)
        (when-some [^dart:async/Timer t @+cljd-conn-timer+] (.cancel t) nil)
        (reset! +cljd-conn-timer+
          (dart:async/Timer (Duration .seconds 3) (fn [] (reset! +cljd-connected+ false) nil)))
        ;; re-arm so atoms of newly-mounted repl-points get watched
        (when @+cljd-recording?+ (arm-recording! true))
        (dart:async/Future.value (dev/ServiceExtensionResponse.result "{\"ok\":true}"))))
    ;; chain onto FlutterError.onError, still calling the previous handler
    (let [prev foundation/FlutterError.onError]
      (set! foundation/FlutterError.onError
        (fn [^foundation/FlutterErrorDetails d]
          (report-error! "flutter" (str (.-exception d)) (str (.-stack d)))
          (when prev (prev d))
          nil)))
    ;; uncaught async errors; false lets the platform default still run
    (set! (.-onError dart:ui/PlatformDispatcher.instance)
      (fn [^Object e ^StackTrace s]
        (report-error! "async" (str e) (str s))
        false))
    (add-tap tap->host)
    nil)                                ; registerExtension returns void
  nil)

(defn- element-app-loc
  "EL's own source {:src :name :type} if app-authored (createdByLocalProject), else nil."
  [^widgets/Element el]
  (try
    (when-some [^String j (inspector-node el false)]
      ;; only EL's own node (before "children"), or a descendant's createdByLocalProject matches
      (let [ci (.indexOf j "\"children\"")
            own (if (neg? ci) j (subs j 0 ci))]
        (when-not (neg? (.indexOf own "\"createdByLocalProject\":true"))
          ;; creationLocation.name is a param name, not the type
          (some-> (parse-creation-loc own)
                  (assoc :type (str (.-runtimeType (.-widget el))))))))
    (catch Object _ nil)))

(declare pick-element!)

(defn- capture-ancestors
  "App-authored ancestors above EL, deepest first, as {:type :src :el}; capped."
  [^widgets/Element el]
  (let [out (atom []) seen (atom 0)]
    (.visitAncestorElements el
      (fn [^widgets/Element a]
        (swap! seen inc)
        (when-some [loc (element-app-loc a)]
          (swap! out conj {:type (:type loc) :src (:src loc) :el a}))
        (and (< (count @out) 6) (< @seen 40))))
    @out))

(defn pick-env
  "The pick's lexical scope {'sym val}, re-read live from its ReplState; nil if unmounted."
  [p]
  (when-some [^ReplState st (:state p)]
    (when (.-mounted st)
      ((.-get_envmap ^ReplPointWidget (.-widget st))))))

(defn- live-state
  "{[loc sym] → atom} for live repl-point atoms under ::app-root; ids stay stable across rebuild/restart (host replays by id)."
  []
  (let [out (atom {}) seen #dart []]
    (when-some [root (some-> (global-key ::app-root) .-currentContext)]
      (letfn [(walk [^widgets/Element el]
                (when (and (instance? widgets/StatefulElement el)
                           (instance? ReplState (.-state ^widgets/StatefulElement el)))
                  (let [^ReplState st (.-state ^widgets/StatefulElement el)
                        ^ReplPointWidget w (.-widget st)
                        sl (.-source_loc w)
                        loc (str (:ns sl) ":" (:line sl))]
                    (doseq [e ((.-get_envmap w))]
                      (let [v (val e)]
                        (when (and (dart/is? v cljd.core/Atom)
                                   (not (some (fn [x] (identical? x v)) seen)))
                          (.add seen v)
                          (swap! out assoc [loc (str (key e))] v))))))
                (.visitChildElements el (fn [c] (walk c) nil))
                nil)]
        (.visitChildElements ^widgets/Element root (fn [c] (walk c) nil))))
    @out))

(defn read-state
  "The app's live state as data: {[loc sym] → value}.
   Mid-frame the walk is illegal during build, so it returns a Future: host callers must eval with :await? true."
  []
  (let [snapshot (fn [] (into {} (map (fn [e] [(key e) @(val e)])) (live-state)))
        wb (widgets/WidgetsBinding.instance)]
    (if (= (.-schedulerPhase wb) scheduler/SchedulerPhase.idle)
      (snapshot)
      (let [c (dart:async/Completer.)]
        (.addPostFrameCallback wb (fn [_] (.complete c (snapshot)) nil))
        (.scheduleFrame wb)
        (.-future c)))))

(defn write-state
  "Resets each live state atom whose id is in SNAP {[loc sym] → value}; returns the match count.
   When idle applies now (a post-frame callback may never pump); mid-frame defers to post-frame,
   since reset!→setState and the walk are illegal during build, and returns (count snap)."
  [snap]
  (let [wb (widgets/WidgetsBinding.instance)
        apply! (fn []
                 (try
                   (reset! +cljd-replaying+ true)
                   (let [live (live-state)]
                     (reduce (fn [n e]
                               (if-some [a (get live (key e))] (do (reset! a (val e)) (inc n)) n))
                             0 snap))
                   (finally (reset! +cljd-replaying+ false))))]
    (if (= (.-schedulerPhase wb) scheduler/SchedulerPhase.idle)
      (apply!)
      (do (.addPostFrameCallback wb (fn [_] (apply!) nil))
          (.scheduleFrame wb)
          (count snap)))))

(defn- flush-tx!
  "Posts the pending buffer as one cljd.tx event (delta + cause) and clears it."
  []
  (reset! +cljd-tx-flush-scheduled+ false)
  (let [delta @+cljd-tx-buffer+]
    (reset! +cljd-tx-buffer+ {})
    (when (seq delta)
      (post-event! "cljd.tx"
        {"delta" (convert/jsonEncode (pr-str delta))
         "cause" (convert/jsonEncode (pr-str @+cljd-tx-cause+))}))))

(defn- record-change!
  "Folds a watched atom change into the pending tx; one microtask flushes it per turn."
  [id new]
  (when (and @+cljd-recording?+ (not @+cljd-replaying+))
    (swap! +cljd-tx-buffer+ assoc id new)
    (when (compare-and-set! +cljd-tx-flush-scheduled+ false true)
      (dart:async/scheduleMicrotask (fn [] (flush-tx!) nil)))))

(defn arm-recording!
  "ON? true watches every live state atom so changes post as cljd.tx (idempotent); false stops."
  [on?]
  (reset! +cljd-recording?+ (boolean on?))
  (when on?
    (doseq [e (live-state)]
      (let [id (key e)]
        (add-watch (val e) id (fn [_ _ _ new] (record-change! id new) nil)))))
  (boolean on?))

(defn- make-pick
  "Pick map from the enclosing repl-point STATE and the hit TARGET element."
  [^ReplState state ^widgets/Element target]
  (let [^ReplPointWidget w (.-widget state)
        ^rendering/RenderBox ro (.-renderObject target)
        rect (rendering/MatrixUtils.transformRect (.getTransformTo ro nil) (.-paintBounds ro))]
    {:scope-loc (.-source_loc w)
     :widget-loc (pick-widget-loc target)
     :type (str (.-runtimeType (.-widget target)))
     :widget (.-widget target)
     :ancestors (capture-ancestors target)
     :state state
     :rect rect}))

(defn- notify-pick!
  "Posts a pick's Dart wloc and ancestor wlocs to the host for .cljd resolution."
  [pick]
  (when-let [src (:src (:widget-loc pick))]
    (post-event! "cljd.pick"
      {"src" (convert/jsonEncode src)
       "ancestors" (str "[" (apply str (interpose "," (map (fn [a] (convert/jsonEncode (:src a))) (:ancestors pick)))) "]")})))

(defn- capture-pick!
  "Toggles the pick for TARGET in +cljd-picks+ (dedup by rect); notifies the host on add."
  [^ReplState state ^widgets/Element target]
  (let [pick (make-pick state target)
        k (rect-key (:rect pick))
        before (count @+cljd-picks+)
        after (swap! +cljd-picks+
                (fn [ps] (if (some #(= (rect-key (:rect %)) k) ps)
                           (vec (remove #(= (rect-key (:rect %)) k) ps))   ; toggle off
                           (conj ps pick))))]
    (when (> (count after) before) (notify-pick! (peek after)))
    nil))

;; Tool toggles; debug-paint flags aren't reactive, so each reassembles. Each returns the new state.
(defn- tools-reassemble! []
  ;; microtask: reassembling inside a pointer-event flush trips GestureBinding's assert(!locked)
  (dart:async/scheduleMicrotask
    (fn [] (.reassembleApplication (widgets/WidgetsBinding.instance)) nil))
  nil)
(defn paint!    ([] (paint! (not rendering/debugPaintSizeEnabled)))
                ([on] (set! rendering/debugPaintSizeEnabled (boolean on)) (tools-reassemble!) on))
(defn repaint!  ([] (repaint! (not rendering/debugRepaintRainbowEnabled)))
                ([on] (set! rendering/debugRepaintRainbowEnabled (boolean on)) (tools-reassemble!) on))
(defn baseline! ([] (baseline! (not rendering/debugPaintBaselinesEnabled)))
                ([on] (set! rendering/debugPaintBaselinesEnabled (boolean on)) (tools-reassemble!) on))
(defn pointers! ([] (pointers! (not rendering/debugPaintPointersEnabled)))
                ([on] (set! rendering/debugPaintPointersEnabled (boolean on)) (tools-reassemble!) on))
(defn arm!      ([] (arm! true))
                ([on] (reset! +cljd-armed+ (boolean on)) (tools-reassemble!) (boolean on)))

(def ^:private +paint-tools+
  "Debug-paint tools as data; the toolbar buttons project from this."
  [{:key "cljd-tb-paint"    :icon material/Icons.grid_4x4    :toggle paint!    :active #(boolean rendering/debugPaintSizeEnabled)}
   {:key "cljd-tb-repaint"  :icon material/Icons.gradient    :toggle repaint!  :active #(boolean rendering/debugRepaintRainbowEnabled)}
   {:key "cljd-tb-baseline" :icon material/Icons.text_fields :toggle baseline! :active #(boolean rendering/debugPaintBaselinesEnabled)}
   {:key "cljd-tb-pointers" :icon material/Icons.touch_app   :toggle pointers! :active #(boolean rendering/debugPaintPointersEnabled)}])

(defn- pick-src-line
  "[text color] for a pick's source: the .cljd loc, the Dart wloc once confirmed non-cljd, else 'resolving…'."
  [p]
  (cond
    (:cljd p)      [(:cljd p) +go+]
    (:resolved? p) [(str (:src (:widget-loc p)) "  (dart)") material/Colors.white70]
    :else          ["resolving…" material/Colors.white38]))

(defn- text-fits?
  "True if T laid out in STYLE (one line) is ≤ MAX-W wide."
  [^String t ^widgets/TextStyle style ^double max-w]
  (let [tp (widgets/TextPainter .text (widgets/TextSpan .text t .style style)
             .textDirection widgets/TextDirection.ltr .maxLines 1)]
    (.layout tp)
    (let [ok (<= (.-width tp) max-w)] (.dispose tp) ok)))

(defn- middle-elide
  "Middle-truncates S with '…' to fit MAX-W in STYLE."
  [^String s ^widgets/TextStyle style ^double max-w]
  (if (or (<= (count s) 4) (text-fits? s style max-w))
    s
    (let [n (count s)]
      (loop [lo 1 hi (dec n) best "…"]
        (if (> lo hi)
          best
          (let [k (quot (+ lo hi) 2)
                h (quot (inc k) 2) t (quot k 2)
                cand (str (subs s 0 h) "…" (subs s (- n t)))]
            (if (text-fits? cand style max-w)
              (recur (inc k) hi cand)
              (recur lo (dec k) best))))))))

(defn- path-text
  "One-line Text middle-eliding S to the available width."
  [^String s ^widgets/TextStyle style]
  (widgets/LayoutBuilder
    .builder (fn [_ctx ^widgets/BoxConstraints cons]
               (widgets/Text (middle-elide s style (.-maxWidth cons))
                 .maxLines 1 .softWrap false .style style))))

(defn- fmt-val
  "Render an env value for the inspector: deref atoms to show the live value."
  [v]
  (if (instance? cljd.core/Atom v)
    (str "@" (deref v))
    (str v)))

(defn- user-key?
  "A lexical-scope symbol worth showing: skip compiler gensyms (contain '__' or lead with '_')."
  [sym]
  (let [n (name sym)]
    (and (not (.startsWith n "_")) (neg? (.indexOf n "__")))))

(defn- kv-row
  "One 'name  value' row: teal key, dim value, value ellipsis-truncated at 2 lines."
  [k v]
  (widgets/Padding
    .padding (widgets/EdgeInsets.symmetric .vertical 2.5)
    .child
    (widgets/Row
      .mainAxisSize widgets/MainAxisSize.max
      .crossAxisAlignment widgets/CrossAxisAlignment.start
      .children
      [(widgets/Text (str k)
         .style (widgets/TextStyle .color (widgets/Color 0xFF80CBC4) .fontSize 12.5))
       (widgets/SizedBox .width 10.0)
       (widgets/Expanded
         .child (widgets/Text (str v)
                  .maxLines 2 .overflow widgets/TextOverflow.ellipsis
                  .style (widgets/TextStyle .color material/Colors.white70 .fontSize 12.5)))])))

(defn- detail-section
  "A dim LABEL then the kv ROWS (each [k v]); nothing if empty and not :always."
  [label rows always?]
  (when (or always? (seq rows))
    (widgets/Padding
      .padding (widgets/EdgeInsets.only .top 7.0)
      .child
      (widgets/Column
        .mainAxisSize widgets/MainAxisSize.min
        .crossAxisAlignment widgets/CrossAxisAlignment.start
        .children
        (into [(widgets/Text label
                 .style (widgets/TextStyle .color material/Colors.white38 .fontSize 11.0
                          .letterSpacing 0.6))]
          (if (seq rows)
            ;; a row may carry an optional 3rd element = on-tap fn → the row becomes tappable
            (mapv (fn [[k v on-tap]]
                    (if on-tap
                      (widgets/GestureDetector .behavior widgets/HitTestBehavior.opaque
                        .onTap on-tap .child (kv-row k v))
                      (kv-row k v)))
              rows)
            [(widgets/Text "  —" .style (widgets/TextStyle .color material/Colors.white24 .fontSize 12.0))]))))))

;; ── Inspector: pick ──pick->sections──► data ──render-sections──► widgets ──

(defn- prop-cljd-value
  "A property's value as cljd text: nil for defaults, strings quoted, else toString."
  [^foundation/DiagnosticsNode n]
  (let [v (.-value n)]
    (cond (nil? v)     nil
          (string? v)  (str "\"" v "\"")
          :else        (str v))))

(defn- widget-props
  "A widget's non-null diagnostic properties as [name value] pairs."
  [^widgets/Widget w]
  (->> (try (.getProperties (.toDiagnosticsNode w)) (catch Object _ nil))
       (keep (fn [^foundation/DiagnosticsNode n]
               (when-some [nm (.-name n)]
                 (when-some [v (prop-cljd-value n)] [nm v]))))
       (take 14) vec))

(defn- env->rows
  "cljd scope as [sym value] pairs — user bindings only (gensyms filtered), atoms deref'd."
  [env]
  (->> (seq env)
       (filter (fn [e] (user-key? (first e))))
       (sort-by (fn [e] (name (first e))))
       (mapv (fn [e] [(str (first e)) (fmt-val (second e))]))))

(defn- pick->sections
  "A pick as display data {:box :sections}: props as cljd named args, tree, scope."
  [p]
  (let [^widgets/Rect r (:rect p)
        ctor (or (:name (:widget-loc p)) (:type p) "widget")           ; the widget, as a cljd constructor
        props (mapv (fn [[n v]] [(str "." n) v])                 ; each prop as a cljd named arg
                    (some-> (:widget p) widget-props))]
    {:box (when r (str "▭ " (.round (.-width r)) "×" (.round (.-height r))
                       "  @ " (.round (.-left r)) "," (.round (.-top r))))
     :sections [{:label (str "(" ctor)  :rows props}             ; cljd interop view of the widget
                {:label "TREE ↑ (tap→pick)"
                 :rows (mapv (fn [a] [(:type a) (or (:cljd a) (:src a))
                                      ;; tap → pick it; guarded, the element may have unmounted
                                      (when-some [el (:el a)]
                                        (fn [] (try (pick-element! el) (catch Object _ nil)) nil))])
                             (:ancestors p))}
                {:label "SCOPE"  :rows (env->rows (pick-env p)) :always? true}]}))

(defn- render-sections
  "Render pick->sections DATA to widgets: the box line, then each section (label + kv rows)."
  [{:keys [box sections]}]
  (widgets/Padding
    .padding (widgets/EdgeInsets.only .left 18.0 .bottom 4.0)
    .child
    (widgets/Column
      .mainAxisSize widgets/MainAxisSize.min
      .crossAxisAlignment widgets/CrossAxisAlignment.start
      .children
      (into []
        (remove nil?
          (cons
            (when box (widgets/Padding .padding (widgets/EdgeInsets.only .top 3.0)
                        .child (widgets/Text box
                                 .style (widgets/TextStyle .color material/Colors.white54 .fontSize 12.0))))
            (map (fn [{:keys [label rows always?]}] (detail-section label rows always?)) sections)))))))

(defn- pick-details [p] (render-sections (pick->sections p)))

(defn- repl-pick-row [i p]
  (let [nm (or (:name (:widget-loc p)) (:type p) "widget")
        [src-str src-color] (pick-src-line p)
        expanded? (:expanded? p)
        toggle (fn [] (let [k (rect-key (:rect p))]
                        (swap! +cljd-picks+
                          (fn [ps] (mapv (fn [q] (if (= (rect-key (:rect q)) k)
                                                   (update q :expanded? not) q)) ps))))
                 nil)
        row (widgets/Row
              .mainAxisSize widgets/MainAxisSize.max
              .crossAxisAlignment widgets/CrossAxisAlignment.start
              .children
              [(widgets/Padding
                 .padding (widgets/EdgeInsets.only .top 3.0)
                 .child (widgets/Container
                          .width 10.0 .height 10.0
                          .decoration (widgets/BoxDecoration .color (pick-color i)
                                        .shape widgets/BoxShape.circle)))
               (widgets/SizedBox .width 8.0)
               ;; tap the name/source to expand this pick's scope (env) below it
               (widgets/Expanded
                 .child
                 (widgets/GestureDetector
                   .behavior widgets/HitTestBehavior.opaque
                   .onTap toggle
                   .child
                   (widgets/Column
                     .mainAxisSize widgets/MainAxisSize.min
                     .crossAxisAlignment widgets/CrossAxisAlignment.start
                     .children
                     [(widgets/Text (str (if expanded? "▾ " "▸ ") nm)
                        .maxLines 1 .overflow widgets/TextOverflow.ellipsis
                        .style (widgets/TextStyle .color material/Colors.white .fontSize 15.0))
                      (path-text src-str (widgets/TextStyle .color src-color .fontSize 13.0))])))
               (widgets/SizedBox .width 8.0)
               (widgets/GestureDetector
                 .onTap (fn [] (remove-pick! p) nil)
                 .child (widgets/Padding .padding (widgets/EdgeInsets.all 4.0)
                          .child (widgets/Icon material/Icons.close .color material/Colors.white38 .size 17.0)))])]
    (widgets/Padding
      .padding (widgets/EdgeInsets.symmetric .vertical 4.0)
      .child
      (if expanded?
        (widgets/Column
          .mainAxisSize widgets/MainAxisSize.min
          .crossAxisAlignment widgets/CrossAxisAlignment.start
          .children [row (pick-details p)])
        row))))

(defn- repl-hover-row
  "Live refine readout below the picks: hovered app widget's type, size and loc."
  [hover]
  (let [r (some-> (:el hover) elem-rect)
        dim (when r (str "   " (.round (.-width ^widgets/Rect r))
                         "×" (.round (.-height ^widgets/Rect r))))]
    (widgets/Padding
      .padding (widgets/EdgeInsets.only .top 6.0)
      .child
      (widgets/Row
        .mainAxisSize widgets/MainAxisSize.max
        .crossAxisAlignment widgets/CrossAxisAlignment.start
        .children
        [(widgets/Padding
           .padding (widgets/EdgeInsets.only .top 2.0)
           .child (widgets/Icon material/Icons.my_location .color +cyan+ .size 14.0))
         (widgets/SizedBox .width 6.0)
         (widgets/Expanded
           .child
           (widgets/Column
             .mainAxisSize widgets/MainAxisSize.min
             .crossAxisAlignment widgets/CrossAxisAlignment.start
             .children
             [(widgets/Text (str (or (:type hover) (:name hover) "widget") dim)
                .maxLines 1 .overflow widgets/TextOverflow.ellipsis
                .style (widgets/TextStyle .color +cyan+ .fontSize 14.0))
              (path-text (or (:src hover) "") (widgets/TextStyle .color (widgets/Color 0xB340C4FF) .fontSize 12.0))]))]))))

(defn- repl-selections-column
  "Picks list: 'N picked' header (× clears all), a row per pick, then the refine readout."
  [picks hover]
  (widgets/Column
    .mainAxisSize widgets/MainAxisSize.min
    .crossAxisAlignment widgets/CrossAxisAlignment.stretch
    .children
    (cond->
      (into
        [(widgets/Row
           .mainAxisSize widgets/MainAxisSize.max
           .children
           [(widgets/Text (str (count picks) " picked")
              .style (widgets/TextStyle .color +go+ .fontSize 15.0))
            (widgets/Spacer)
            (widgets/GestureDetector
              .onTap (fn [] (reset! +cljd-picks+ []) nil)
              .child (widgets/Padding .padding (widgets/EdgeInsets.all 4.0)
                       .child (widgets/Icon material/Icons.close .color material/Colors.white54 .size 20.0)))])
         (widgets/SizedBox .height 6.0)]
        (map-indexed (fn [i p] (repl-pick-row i p)) picks))
      (:type hover) (conj (widgets/Container .height 1.0 .margin (widgets/EdgeInsets.symmetric .vertical 4.0)
                            .color (widgets/Color 0x22FFFFFF))
                          (repl-hover-row hover)))))

;; ── Errors tab — the SAME panel machinery pointed at the error store ─────────
(def ^:private +phase-color+
  {"compile" 0xFFFFB300 "runtime" 0xFFFF5252 "flutter" 0xFFFF7043 "async" 0xFFAB47BC
   "reload" 0xFF29B6F6})

(defn- repl-error-row [i e]
  (let [expanded? (= i @+cljd-error-expanded+)
        color (widgets/Color (get +phase-color+ (:phase e) 0xFFFF5252))
        stack (:stack e)
        toggle (fn [] (swap! +cljd-error-expanded+ (fn [c] (when-not (= c i) i))) nil)
        head (widgets/Row
               .crossAxisAlignment widgets/CrossAxisAlignment.start
               .children
               [(widgets/Padding .padding (widgets/EdgeInsets.only .top 3.0)
                  .child (widgets/Container .width 10.0 .height 10.0
                           .decoration (widgets/BoxDecoration .color color .shape widgets/BoxShape.circle)))
                (widgets/SizedBox .width 8.0)
                (widgets/Expanded
                  .child (widgets/Column
                           .mainAxisSize widgets/MainAxisSize.min
                           .crossAxisAlignment widgets/CrossAxisAlignment.start
                           .children
                           [(widgets/Text (str (:phase e) (when (< 1 (or (:count e) 1)) (str "  ×" (:count e))))
                              .style (widgets/TextStyle .color color .fontSize 11.0 .letterSpacing 0.6))
                            (widgets/Text (or (:message e) "")
                              .maxLines (if expanded? 8 2) .overflow widgets/TextOverflow.ellipsis
                              .style (widgets/TextStyle .color material/Colors.white .fontSize 13.5))]))])]
    (widgets/GestureDetector
      .behavior widgets/HitTestBehavior.opaque
      .onTap toggle
      .child (widgets/Padding
               .padding (widgets/EdgeInsets.symmetric .vertical 5.0)
               .child (if (and expanded? (seq stack))
                        (widgets/Column .mainAxisSize widgets/MainAxisSize.min
                          .crossAxisAlignment widgets/CrossAxisAlignment.start
                          .children [head
                                     (widgets/Padding .padding (widgets/EdgeInsets.only .left 18.0 .top 4.0)
                                       .child (widgets/Text stack
                                                .style (widgets/TextStyle .color material/Colors.white54
                                                         .fontSize 11.0 .fontFamily "monospace")))])
                        head)))))

(defn- repl-errors-column
  "The errors list: a 'N errors' header (× clears all), newest first, tap a row to expand its stack."
  [errs]
  (widgets/Column
    .mainAxisSize widgets/MainAxisSize.min
    .crossAxisAlignment widgets/CrossAxisAlignment.stretch
    .children
    (into
      [(widgets/Row
         .children
         [(widgets/Text (str (count errs) " error" (when (not= 1 (count errs)) "s"))
            .style (widgets/TextStyle .color (if (seq errs) (widgets/Color 0xFFFF5252) material/Colors.white54)
                     .fontSize 15.0))
          (widgets/Spacer)
          (widgets/GestureDetector
            .onTap (fn [] (reset! +cljd-errors-local+ []) (reset! +cljd-error-expanded+ nil) nil)
            .child (widgets/Padding .padding (widgets/EdgeInsets.all 4.0)
                     .child (widgets/Icon material/Icons.close .color material/Colors.white54 .size 20.0)))])
       (widgets/SizedBox .height 6.0)]
      (if (seq errs)
        (map-indexed (fn [i e] (repl-error-row i e)) (reverse errs))
        [(widgets/Text "no errors" .style (widgets/TextStyle .color material/Colors.white38 .fontSize 13.0))]))))

(defn- repl-panel
  "Inspector below the tools row: picks, then errors. Watches the heartbeat to keep scope live."
  []
  (widget
    :watch [picks +cljd-picks+ errs +cljd-errors-local+
            hover +cljd-refine+ _exp +cljd-error-expanded+ _tick +cljd-connected+]
    :when (or (seq picks) (seq errs) (:type hover))
    (widgets/Padding
      .padding (widgets/EdgeInsets.only .left 10.0 .right 10.0 .bottom 10.0 .top 2.0)
      .child
      (widgets/SizedBox .width 300.0
        .child
        (widgets/Column
          .mainAxisSize widgets/MainAxisSize.min
          .crossAxisAlignment widgets/CrossAxisAlignment.start
          .children
          (into []
            (remove nil?
              [(when (or (seq picks) (:type hover)) (repl-selections-column picks hover))
               ;; divider only when both sections are present
               (when (and (seq errs) (or (seq picks) (:type hover)))
                 (widgets/Container .height 1.0 .margin (widgets/EdgeInsets.symmetric .vertical 8.0)
                   .color (widgets/Color 0x22FFFFFF)))
               (when (seq errs) (repl-errors-column errs))])))))))

(defn repl-toolbar
  "A draggable in-app debug toolbar (kDebugMode only). `*armed` is repl-hud's picker flag."
  [*armed]
  (letfn [(btn [k icon active? on-tap]
            ;; keyed for ByValueKey tapping; on-tap fns reassemble themselves
            (widgets/GestureDetector
              .key (widgets/ValueKey k)
              .onTap (fn [] (on-tap) nil)
              .child (widgets/Container
                       .decoration (widgets/BoxDecoration
                                     .color (if active? (widgets/Color 0x3300E676) (widgets/Color 0x00000000))
                                     .borderRadius (widgets/BorderRadius.circular 12.0))
                       .child (widgets/Padding
                                .padding (widgets/EdgeInsets.all 12.0)
                                .child (widgets/Icon icon
                                         .color (if active? +go+ material/Colors.white54)
                                         .size 24.0)))))]
    (widget
      :managed [*pos (atom (widgets/Offset 16.0 90.0)) :dispose nil
                *collapsed (atom false) :dispose nil]
      :watch [pos *pos
              collapsed *collapsed
              conn +cljd-connected+
              errs +cljd-errors-local+
              hidden +cljd-toolbar-hidden+]
      ;; logical screen size (no MediaQuery above MaterialApp — read the FlutterView).
      :let [screen (let [m (device-metrics)] [(:w m) (:h m)])
            drag! (fn [^widgets/DragUpdateDetails d]
                    (swap! *pos (fn [^widgets/Offset o]
                                  (widgets/Offset (+ (.-dx o) (.-dx (.-delta d)))
                                                  (+ (.-dy o) (.-dy (.-delta d)))))))
            ;; handle taps to collapse; its icon is the status light (link-down wins over errors)
            handle (widgets/GestureDetector
                     .onTap (fn [] (swap! *collapsed not) nil)   ; :watch rebuilds; no reassemble
                     .child (widgets/Padding
                              .padding (widgets/EdgeInsets.all 12.0)
                              .child (widgets/Icon
                                       (if collapsed material/Icons.developer_mode
                                           material/Icons.drag_indicator)
                                       .color (cond (not conn) material/Colors.white54       ; link down
                                                    (seq errs)  (widgets/Color 0xFFFFC107)    ; amber — errors
                                                    :else       +go+)                          ; green — healthy
                                       .size 24.0)))
            ]
      (if hidden
       (widgets/SizedBox.shrink)
       (widgets/Align
         .alignment widgets/Alignment.topLeft
         .child
         ;; Transform.translate, not EdgeInsets: EdgeInsets asserts non-negative insets
         (widgets/Transform.translate
          ;; clamp at render so any :pos stays on-screen; -56 keeps the handle (44) + pad visible
          .offset (widgets/Offset
                    (.clamp (.-dx ^widgets/Offset pos) 12.0 (max 12.0 (- (nth screen 0) 56.0)))
                    (.clamp (.-dy ^widgets/Offset pos) 12.0 (max 12.0 (- (nth screen 1) 56.0))))
          .child
          ;; above MaterialApp: own Directionality, Container+Icon (Material widgets need Theme)
          (NoDebugPaint
           (widgets/Directionality
            .textDirection widgets/TextDirection.ltr
            .child
            ;; pan anywhere drags; the gesture arena still routes taps to buttons
            (widgets/GestureDetector
             .onPanUpdate drag!
             .child
             (widgets/Container
                .decoration (widgets/BoxDecoration
                              .color (widgets/Color 0xF2101418)
                              .borderRadius (widgets/BorderRadius.circular 22.0))
                .child
                (if collapsed
                  handle
                  (widgets/Column
                    .mainAxisSize widgets/MainAxisSize.min
                    .crossAxisAlignment widgets/CrossAxisAlignment.start
                    .children
                    [(widgets/Row
                       .mainAxisSize widgets/MainAxisSize.min
                       .children
                       ;; buttons project from data: handle (status light) + pick + +paint-tools+
                       (into [handle
                              (btn "cljd-tb-pick" material/Icons.highlight_alt @*armed
                                   (fn [] (arm! (not @*armed))))]
                         (mapv (fn [t] (btn (:key t) (:icon t) ((:active t)) (:toggle t))) +paint-tools+)))
                     ;; self-watching → rebuilds on any pick change, no reassemble
                     (repl-panel)]))))))))))))

;; Refine pick (tap+hold, scrub, release): nil | {:el :src :name :hit :finger}.
(defonce ^:private +cljd-refine+ (atom nil))

(defn- hit-element
  "Deepest widget Element under screen position POS."
  [^widgets/Offset pos]
  (let [result (rendering/BoxHitTestResult)]
    (-> ::app-root global-key ^widgets/Element (.-currentContext)
        ^rendering/RenderBox (.-renderObject) (.hitTest result .position pos))
    (some (fn [^rendering/HitTestEntry {:flds [target]}]   ; :flds name = the field: .target
            (when (instance? rendering/RenderObject target)
              (some-> ^rendering/RenderObject target ^widgets/DebugCreator (.-debugCreator) .-element)))
          (-> result .-path))))

(defn- nearest-app-widget
  "Deepest app-authored widget at or above EL as {:el :src :name}, or nil."
  [^widgets/Element el]
  (if-some [loc (element-app-loc el)]
    (assoc loc :el el)
    (let [found (atom nil) seen (atom 0)]
      (.visitAncestorElements el
        (fn [^widgets/Element a]
          (swap! seen inc)
          (if-some [loc (element-app-loc a)]
            (do (reset! found (assoc loc :el a)) false)   ; stop at first app ancestor
            (< @seen 40))))
      @found)))

(defn- elem-rect [^widgets/Element el]
  (when-some [ro (.-renderObject el)]
    (rendering/MatrixUtils.transformRect (.getTransformTo ^rendering/RenderBox ro nil)
                                         (.-paintBounds ^rendering/RenderBox ro))))

(defn- pick-element!
  "Nearest repl-point above EL, then capture-pick! it (the one pick hook)."
  [^widgets/Element el]
  (let [repl-elts #dart ^widgets/StatefulElement []]
    (.visitAncestorElements el
      (fn [^widgets/Element a]
        (when (and (instance? widgets/StatefulElement a)
                   (instance? ReplState (.-state ^widgets/StatefulElement a)))
          (.add repl-elts a))
        true))
    (when-some [^ReplState state (some-> repl-elts .-first .-state)]
      (capture-pick! state el)
      (-> state .-m :*active-state (reset! state)))
    nil))

(defn- repl-highlights
  "Paints pick and refine highlights; inside ::app-snap so the magnifier captures them."
  []
  (widget
    :watch [picks +cljd-picks+ hover +cljd-refine+]
    :when (or (seq picks) (:el hover))
    :let [hrect (some-> (:el hover) elem-rect)]
    (widgets/IgnorePointer
      .child
      (widgets/CustomPaint
        .size widgets/Size.infinite
        .painter
        (reify :extends (widgets/CustomPainter)
          :no-meta true
          (paint [_ canvas _size]
            (let [stroke (fn [^widgets/Rect r ^widgets/Color color]
                           (.drawRRect canvas
                             (widgets/RRect.fromRectAndRadius r (widgets/Radius.circular 4.0))
                             (doto (widgets/Paint)
                               (.-color! color)
                               (.-style! widgets/PaintingStyle.stroke)
                               (.-strokeWidth! 2.5))))]
              (doseq [[i p] (map-indexed vector picks) :when (:rect p)]
                (stroke (:rect p) (pick-color i)))   ; colour matches the inspector swatch
              (when-some [^widgets/Rect hr hrect]
                (stroke hr +cyan+)))
            nil)
          (shouldRepaint [_ _] true))))))

(defn- repl-magnifier
  "Long-press loupe from a ::app-snap snapshot; unlike RawMagnifier it can render above the toolbar."
  []
  (widget
    :watch [hover +cljd-refine+]
    :when (:finger hover)
    :let [^widgets/Offset f (:finger hover)
          rad 52.0 gap 84.0 margin 8.0 mag 1.4
          m (device-metrics) dpr (:dpr m) screen (:w m)
          fx (.-dx f) fy (.-dy f)
          above? (> fy (+ gap rad margin))
          cx (.clamp fx (+ rad margin) (max (+ rad margin) (- screen rad margin)))
          cy (if above? (- fy gap) (+ fy gap))]
    (widgets/IgnorePointer
      .child
      (widgets/CustomPaint
        .size widgets/Size.infinite
        .painter
        (reify :extends (widgets/CustomPainter)
          :no-meta true
          (paint [_ canvas _size]
            (try
              (when-some [ctx (.-currentContext (global-key ::app-snap))]
                (when-some [ro (.findRenderObject ^widgets/BuildContext ctx)]
                  (let [^rendering/RenderRepaintBoundary rb ro
                        img (.toImageSync rb .pixelRatio dpr)
                        sh (* (/ rad mag) dpr)                 ; source half-size in image px
                        src (widgets/Rect.fromCenter .center (widgets/Offset (* fx dpr) (* fy dpr))
                                                     .width (* 2.0 sh) .height (* 2.0 sh))
                        dst (widgets/Rect.fromCircle .center (widgets/Offset cx cy) .radius rad)]
                    (.save canvas)
                    (.clipRRect canvas (widgets/RRect.fromRectAndRadius dst (widgets/Radius.circular rad)))
                    (.drawImageRect canvas img src dst (widgets/Paint))
                    (.restore canvas)
                    (.dispose img)
                    ;; neutral hairline glass edge (not cyan → doesn't fight the highlights)
                    (.drawCircle canvas (widgets/Offset cx cy) rad
                      (doto (widgets/Paint)
                        (.-color! (widgets/Color 0x59FFFFFF))
                        (.-style! widgets/PaintingStyle.stroke)
                        (.-strokeWidth! 1.0)))
                    ;; focal dot: white with a dark halo, marks the exact finger point
                    (.drawCircle canvas (widgets/Offset cx cy) 3.5
                      (doto (widgets/Paint) (.-color! (widgets/Color 0x99000000))))
                    (.drawCircle canvas (widgets/Offset cx cy) 2.0
                      (doto (widgets/Paint) (.-color! (widgets/Color 0xFFFFFFFF)))))))
              (catch Object _ nil))
            nil)
          (shouldRepaint [_ _] true))))))

(defn repl-hud [child]
  (widget
    ;; cljd.booted on every root mount, incl. hot restart; the host refreshes its isolate id off it
    :managed [_ (do (register-cljd-devtools!) (post-event! "cljd.booted" {}) (println "[* RDY)_")) :dispose nil]
    :let [*armed +cljd-armed+]
    (widgets/Stack
      .alignment widgets/AlignmentGeometry.topLeft
      .fit widgets/StackFit.expand
      .children
      [(widget
         :bind {:cljd.flutter.repl-impl/armed *armed}
         :global-key ::app-root
         ;; ::app-snap wraps app + highlights only; non-directional alignment (no Directionality here)
         (widgets/RepaintBoundary
           .key (global-key ::app-snap)
           .child
           (widgets/Stack
             .alignment widgets/Alignment.topLeft
             .fit widgets/StackFit.expand
             .children [child (repl-highlights)])))
       (widget
         :watch [armed *armed]
         :when armed
         ;; GestureDetector (not Listener) so the arena separates tap from long-press-drag
         (widgets/GestureDetector
           .behavior widgets/HitTestBehavior.opaque
           .onTapUp
           (fn [^widgets/TapUpDetails d]
             (when-some [el (hit-element (.-globalPosition d))]
               (when-some [m (nearest-app-widget el)] (pick-element! (:el m))))
             nil)
           .onLongPressStart
           (fn [^widgets/LongPressStartDetails d]
             (let [pos (.-globalPosition d)]
               (when-some [el (hit-element pos)]
                 (reset! +cljd-refine+ (assoc (or (nearest-app-widget el) {}) :hit el :finger pos))))
             nil)
           .onLongPressMoveUpdate
           (fn [^widgets/LongPressMoveUpdateDetails d]
             (let [pos (.-globalPosition d)]
               (when-some [el (hit-element pos)]
                 ;; the app widget (N inspector reads) is recomputed only when the hit changes
                 (if (identical? el (:hit @+cljd-refine+))
                   (swap! +cljd-refine+ assoc :finger pos)
                   (reset! +cljd-refine+ (assoc (or (nearest-app-widget el) {}) :hit el :finger pos)))))
             nil)
           .onLongPressEnd
           (fn [^widgets/LongPressEndDetails d]
             (when-some [m @+cljd-refine+]
               (when (:el m) (pick-element! (:el m))))
             (reset! +cljd-refine+ nil)
             nil)))
       (repl-toolbar *armed)
       ;; loupe last, so it renders above the toolbar
       (repl-magnifier)])))

(defmacro run
  "Starts an application, takes a widget body and uses it as the application root widget.
  Hot-reload friendly."
  [& widget-body]
  `(widgets/runApp
     (cond->
         ~(stateless-flush {}
            (list* :bind `{::repl foundation/kDebugMode} widget-body))
       foundation/kDebugMode repl-hud)))

(deftype Cell [^Map subs]
  (subto [self s])
  (update [self s x]))

(def ^:private ^:dynamic ^Map *old-deps* (Map))
(def ^:private ^:dynamic ^Map *new-deps* (Map))
(def ^:private ^:dynamic ^Cell? *cell* nil)

(defn <!
  ([s]
   (if-some [v (. *new-deps* "[]" s)]
     v
     (if (.containsKey *new-deps* s)
       nil
       (if-some [v (. *old-deps* "[]" s)]
         (do ; move to new gen
           (.remove *old-deps* s)
           (. *new-deps* "[]=" s v)
           v)
         (cond
           (.containsKey *old-deps* s)
           (do ; move to new gen
             (.remove *old-deps* s)
             (. *new-deps* "[]=" s nil)
             nil)
           (-> *cell* .-subs (.containsKey s)) ; subscription which hasn't delivered a value yet and no immediate value
           (throw "no value yet!")
           :else
           ; a new subscription!
           (let [update! (fn [x] (.update *cell* s x))
                 sub (.subto *cell* s)]
             ; subscription is going to fill new-deps
             (if (-call-with-immediate-value s sub update!)
               (. *new-deps* "[]" s)
               (throw "no value yet!"))))))))
  ([s & {:keys [default]}]
   (if-some [v (. *new-deps* "[]" s)]
     v
     (if (.containsKey *new-deps* s)
       nil
       (if-some [v (. *old-deps* "[]" s)]
         (do ; move to new gen
           (.remove *old-deps* s)
           (. *new-deps* "[]=" s v)
           v)
         (if (.containsKey *old-deps* s)
           (do ; move to new gen
             (.remove *old-deps* s)
             (. *new-deps* "[]=" s nil)
             nil)
           (-> *cell* .-subs (.containsKey s)) ; subscription which hasn't delivered a value yet and no immediate value
           default
           ; a new subscription!
           (let [update! (fn [x] (.update *cell* s x))
                 sub (.subto *cell* s)]
             ; subscription is going to fill new-deps
             (if (-call-with-immediate-value s sub update!)
               (. *new-deps* "[]" s)
               default))))))))

(def ^:private NO-VALUE ^:unique (Object))

(deftype Cell [f ^:mutable v ^Map subscribers
               ^:mutable ^int refreshing ^:mutable ^Map deps ^Map subs
               ^:mutable ^Map spare-map]
  (subto [self s]
    (let [sub (-subscribe s (fn [x] (.update self s x)))]
      (. subs "[]=" s sub)
      sub))
  (refresh [self]
    (assert (zero? refreshing))
    ; deps=mapA, spare-map=mapB and mapB is empty
    (let [old-deps deps]
      (set! deps spare-map)
      ; now deps=mapB, spare-map=mapB, old-deps=mapA
      (set! refreshing 1)
      (let [v' (binding [*old-deps* old-deps
                         *new-deps* deps
                         *cell* self]
                 (try
                   (f)
                   (catch Object e
                     v)))]
        (doseq [s (.-keys old-deps)]
          (-unsubscribe s (.remove subs s)))
        (set! spare-map (doto old-deps .clear))
        ; now deps=mapB, spare-map=mapA and mapA is empty
        (when-not (= v v')
          ; propagating new value
          (set! refreshing 2)
          (set! v v')
          (doseq [f! (.-values subscribers)]
            (try (f! v') (catch Object e)))
          (.forEach spare-map
            (fn [sub f!]
              (if (identical? sub f!) ; sub as f! -> tombstone
                (.remove subscribers sub)
                (. subscribers "[]=" sub f!))))
          (.clear spare-map))
        (set! refreshing 0))))
  (update [self s x]
    (case refreshing
      ; not refreshing
      0 (do
          (. deps "[]=" s x)
          (.refresh self))
      ; recomputing
      1 (if (identical? self *cell*) ; init of a fresh subscription
          (. deps "[]=" s x)
          (throw (ex-info "I have no idea if it's legit" {})))
      ; broadcasting new value
      2 (throw (ex-info "Circular dependency" {:cell self}))))
  Subscribable
  (-subscribe [self f!]
    (case refreshing
      ; not refreshing
      0 (let [sub ^:unique (Object)]
          (when (zero? (.-length subscribers))
            (.refresh self))
          (. subscribers "[]=" sub f!)
          sub)
      ; recomputing
      1 (throw (ex-info "Circular dependency" {:cell self}))
      ; broadcasting new value
      2 (let [sub ^:unique (Object)]
          (. spare-map "[]=" sub f!)
          sub)))
  (-call-with-immediate-value [self sub f!]
    (if (identical? NO-VALUE v)
      false
      (do (f! v) true)))
  (-unsubscribe [self sub]
    (case refreshing
      0 (do
          (.remove subscribers sub)
          (when (zero? (.-length subscribers))
            (.forEach subs (fn [s sub] (-unsubscribe s sub)))
            (.clear subs)
            (.clear deps)
            (set! v nil)))
      1 (throw (ex-info "Circular dependency" {:cell self}))
      2 (. spare-map "[]=" sub sub))))

(defn cell [f]
  (Cell f NO-VALUE (Map/identity) 0 (Map) (Map) (Map)))

(defmacro $ [expr]
  `(cell (fn [] ~expr)))

(deftype Retriable [thunk ^:mutable ^Future? fut ^Map subscriptions]
  Subscribable
  (-subscribe [retriable f!]
    (let [sub ^:unique (Object)]
      (. subscriptions "[]=" sub f!)
      sub))
  (-call-with-immediate-value [x sub f!] false)
  (-unsubscribe [x sub] (.remove subscriptions sub)))

(defn retry!
  "Retries the retrieable, returns a future which will yield a value
   when the current try is over.
   Meant to be used for user-initiated retries, not automatic retries."
  [^Retriable retriable]
  (let [this-fut (.-fut! retriable (Future (.-thunk retriable)))]
    (.then this-fut
      (fn [x]
        (try
          (when (identical? this-fut (.-fut retriable))
            (run! #(% x) (-> retriable .-subscriptions .-values)))
          (catch Object e (dart:core/print e)))))))

(defmacro retriable
  "Returns a retriable: a future-like which can be retried.
   Meant to be used for user-initiated retries, not automatic retries."
  [& async-try-body]
  `(doto (Retriable (fn [] (try ~@async-try-body)) nil (Map))
     retry!))

(extend-type foundation/ValueListenable
  cljd.core/IDeref
  (-deref [vl] (.-value vl)))

(extend-type foundation/ValueNotifier
  cljd.core/IReset
  (-reset! [vn new-value]
    (.-value! vn new-value)))

(defmacro with-notifier
  "Custom directive for `f/widget`.

  Usage:
    ::f/with-notifier ([name init] widget-directives... expr)

  Binds `name` to a `ValueNotifier` initialized with `init`.
  The notifier is updated with the value of `expr` whenever
  it changes.

  Example usage:

    ::f/with-notifier ([progress-notifier 0]
                       :watch [{:keys [progress]} app-state]
                       :animate [progress progress]
                       progress)

  This creates a `ValueNotifier` named `progress-notifier` that
  provides interpolated (animated) progress values between actual
  progress values.
  It can then be passed, for instance, to a `CustomPainter`
  to trigger repaints without rebuilding the widget tree."
  [[[name init] & body] child-prop child]
  (let [body (vec body)
        expr (peek body)
        body (pop body)]
    `(widget
       :managed [notifier# (#/(widgets/ValueNotifier dynamic) ~init)]
       :let [~name notifier#]
       (widget
         ~@body
         :let [_ (reset! notifier# ~expr)])
       ~child-prop
       ~child)))

(defmacro doto-layer
  "(doto-layer canvas [paint rect?]? & body)

  Like `(doto canvas ...)`, but executes the body in a scoped
  `Canvas.saveLayer`/`restore` when `paint` (and optionally `rect`) is
  provided, or in a `Canvas.save`/`restore` otherwise.

  On exit, transforms and clipp paths are restored.

  With a `paint`, the offscreen layer is composited back using it.

  See `Canvas.save` and `Canvas.saveLayer` for details on `rect` and `paint`."
  [canvas layer-args? & doto-body]
  (let [doto-body (cond->> doto-body
                    (and layer-args? (not (vector? layer-args?)))
                    (cons layer-args?))
        layer-args? (when (and (vector? layer-args?)) layer-args?)]
    `(doto ~canvas
       ~(if-some [[paint rect?] layer-args?]
          `(.saveLayer ~rect? ~paint)
          `.save)
       ~@doto-body
       .restore)))

(defmacro doto-image-canvas
  "(doto-image-canvas [w h] & body)

  Like `(doto canvas ...)`, but draws into an offscreen canvas
  and returns an `Image` of the given dimensions."
  [[w h] & doto-body]
  `(let [recorder# (doto (dart:ui/PictureRecorder)
                     (-> dart:ui/Canvas (doto ~@doto-body)))
         picture# (.endRecording recorder#)]
     (try
       (.toImageSync picture# (int ~w) (int ~h))
       (finally (.dispose picture#)))))

